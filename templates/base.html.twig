<!DOCTYPE html>
<html lang="fr" class="overflow-x-hidden">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
		<title>
			{% block title %}Studio Danse 430
			{% endblock %}
		</title>
		<link rel="icon" href="{{ asset('build/images/icon-192.png') }}">
		<link rel="apple-touch-icon" href="{{ asset('build/images/icon-192.png') }}">
		<link rel="manifest" href="{{ asset('manifest.json') }}">

		<meta name="mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
		<meta name="apple-mobile-web-app-title" content="SD430">
		<meta name="theme-color" content="#000000">
		<meta name="description" content="Application officielle du Studio Danse 430">

		{% block stylesheets %}
			{{ encore_entry_link_tags('app') is defined ? encore_entry_link_tags('app') : '' }}
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}

		{% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
		{% if frankenphpHotReload %}
			<meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
			<script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
			<script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
		{% endif %}
	</head>
	<body class="bg-black text-white min-h-screen flex flex-col antialiased overflow-x-hidden pb-16 md:pb-0">
		{% set currentRoute = app.request.attributes.get('_route') %}
		{% set accountPath = app.user and (app.user.foyer or not is_granted('ROLE_TRESORIER'))
			? path('app_foyer_index')
			: (app.user ? path('app_home') : path('app_login')) %}

		<header class="bg-black border-b border-[#FFD700]/30 sticky top-0 z-40">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center h-16 gap-4 lg:gap-6 xl:gap-8">

					<a href="{{ path('app_home') }}" class="flex items-center shrink-0" aria-label="Accueil — Studio Danse 430">
						<img src="{{ asset('images/logo.studio-danse-430.jpg') }}" alt="Studio Danse 430" class="h-12 w-12 sm:h-14 sm:w-14 object-contain rounded shadow-sm">
					</a>

					{# Liens publics — desktop #}
					<nav class="hidden lg:flex flex-1 items-center justify-center gap-x-4 xl:gap-x-6 2xl:gap-x-8 min-w-0" aria-label="Navigation principale">
						<a href="{{ path('app_cours_index') }}" class="py-2 text-sm font-semibold text-white hover:text-[#FFD700] transition-colors duration-200 whitespace-nowrap">
							Cours
						</a>
						<a href="{{ path('app_actualite_index') }}" class="py-2 text-sm font-semibold text-white hover:text-[#FFD700] transition-colors duration-200 whitespace-nowrap">
							Actualités
						</a>
						<a href="{{ path('app_costumes_index') }}" class="py-2 text-sm font-semibold text-white hover:text-[#FFD700] transition-colors duration-200 whitespace-nowrap">
							🎭 Location Costumes
						</a>
						<a href="{{ path('app_boutique_index') }}" class="py-2 text-sm font-semibold text-white hover:text-[#FFD700] transition-colors duration-200 whitespace-nowrap">
							👕 Boutique
						</a>
					</nav>

					<nav class="flex items-center gap-x-3 sm:gap-x-4 lg:gap-x-4 xl:gap-x-5 ms-auto shrink-0" aria-label="Compte utilisateur">
						{% if app.user %}
							{% if is_granted('ROLE_BUREAU') or is_granted('ROLE_TRESORIER') %}
								<a href="{{ path('admin') }}" class="hidden md:inline-flex items-center whitespace-nowrap py-2 text-sm font-semibold text-amber-400 hover:text-amber-300 transition-colors duration-200">🛡️ Admin</a>
							{% endif %}
							{% if is_granted('ROLE_PROF') and not is_granted('ROLE_BUREAU') %}
								<a href="{{ path('app_espace_prof') }}" class="hidden md:inline-flex items-center whitespace-nowrap py-2 text-sm font-semibold text-blue-400 hover:text-blue-300 transition-colors duration-200">💃 Espace Prof</a>
							{% endif %}
							{% if app.user.foyer or not is_granted('ROLE_TRESORIER') %}
								<a href="{{ path('app_foyer_index') }}" class="hidden sm:inline-flex items-center whitespace-nowrap py-2 text-sm font-semibold text-white hover:text-[#FFD700] transition-colors duration-200">🏠 Mon Foyer</a>
							{% endif %}
							<a href="{{ path('app_billets_index') }}" class="hidden sm:inline-flex items-center whitespace-nowrap py-2 text-sm font-semibold text-white hover:text-[#FFD700] transition-colors duration-200">🎫 Mes Billets</a>
							{% if app.user.foyer %}
								<a href="{{ path('app_foyer_inscription_cours') }}" class="hidden sm:inline-flex items-center whitespace-nowrap py-2 text-sm font-semibold text-white hover:text-[#FFD700] transition-colors duration-200">Inscriptions</a>
							{% endif %}
							<a href="{{ path('app_logout') }}"
							   title="Déconnexion"
							   aria-label="Se déconnecter"
							   class="inline-flex items-center justify-center gap-2 px-2.5 sm:px-4 py-2 text-sm font-semibold text-[#FFD700] border border-[#FFD700] rounded-full hover:bg-[#FFD700] hover:text-black transition-colors duration-200">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/>
								</svg>
								<span class="hidden sm:inline">Déconnexion</span>
							</a>
						{% else %}
							<a href="{{ path('app_login') }}" class="hidden sm:inline py-2 text-sm font-semibold text-white hover:text-[#FFD700] transition-colors duration-200">Connexion</a>
							<a href="{{ path('app_register') }}" class="inline-flex items-center gap-2 px-3 sm:px-4 py-2 text-xs sm:text-sm font-semibold bg-[#FFD700] text-black border border-[#FFD700] rounded-full hover:bg-black hover:text-[#FFD700] transition-colors duration-200 uppercase tracking-wider whitespace-nowrap">
								<span class="hidden sm:inline">Créez votre compte</span>
								<span class="sm:hidden">S'inscrire</span>
							</a>
						{% endif %}

						<button type="button"
								id="nav-burger"
								class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-neutral-700 text-white hover:border-[#FFD700] hover:text-[#FFD700] transition-colors"
								aria-expanded="false"
								aria-controls="mobile-nav"
								aria-label="Ouvrir le menu">
							<svg id="nav-burger-open" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
							</svg>
							<svg id="nav-burger-close" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
							</svg>
						</button>
					</nav>
				</div>

				<nav id="mobile-nav"
					 class="lg:hidden hidden pb-4 border-t border-neutral-900"
					 aria-label="Navigation mobile">
					<div class="flex flex-col gap-1 pt-3">
						<a href="{{ path('app_cours_index') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-white hover:bg-neutral-900 hover:text-[#FFD700] transition-colors">Cours</a>
						<a href="{{ path('app_actualite_index') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-white hover:bg-neutral-900 hover:text-[#FFD700] transition-colors">Actualités</a>
						<a href="{{ path('app_costumes_index') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-white hover:bg-neutral-900 hover:text-[#FFD700] transition-colors">🎭 Location Costumes</a>
						<a href="{{ path('app_boutique_index') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-white hover:bg-neutral-900 hover:text-[#FFD700] transition-colors">👕 Boutique</a>
						{% if app.user %}
							{% if is_granted('ROLE_BUREAU') or is_granted('ROLE_TRESORIER') %}
								<a href="{{ path('admin') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-amber-400 hover:bg-neutral-900 transition-colors">🛡️ Administration</a>
							{% endif %}
							{% if is_granted('ROLE_PROF') and not is_granted('ROLE_BUREAU') %}
								<a href="{{ path('app_espace_prof') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-blue-400 hover:bg-neutral-900 transition-colors">💃 Espace Prof</a>
							{% endif %}
							{% if app.user.foyer or not is_granted('ROLE_TRESORIER') %}
								<a href="{{ path('app_foyer_index') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-white hover:bg-neutral-900 hover:text-[#FFD700] transition-colors">🏠 Mon Foyer</a>
							{% endif %}
							<a href="{{ path('app_billets_index') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-white hover:bg-neutral-900 hover:text-[#FFD700] transition-colors">🎫 Mes Billets</a>
							{% if app.user.foyer %}
								<a href="{{ path('app_foyer_inscription_cours') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-white hover:bg-neutral-900 hover:text-[#FFD700] transition-colors">Inscriptions</a>
							{% endif %}
							<a href="{{ path('app_logout') }}"
							   title="Déconnexion"
							   aria-label="Se déconnecter"
							   class="mt-1 px-3 py-2.5 rounded-lg text-sm font-semibold text-[#FFD700] hover:bg-neutral-900 transition-colors inline-flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/>
								</svg>
								Déconnexion
							</a>
						{% else %}
							<a href="{{ path('app_login') }}" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-white hover:bg-neutral-900 hover:text-[#FFD700] transition-colors">Connexion</a>
						{% endif %}
					</div>
				</nav>
			</div>
			<script>
				(function () {
					var btn = document.getElementById('nav-burger');
					var panel = document.getElementById('mobile-nav');
					var iconOpen = document.getElementById('nav-burger-open');
					var iconClose = document.getElementById('nav-burger-close');
					if (!btn || !panel) return;
					btn.addEventListener('click', function () {
						var open = panel.classList.toggle('hidden') === false;
						btn.setAttribute('aria-expanded', open ? 'true' : 'false');
						btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
						if (iconOpen) iconOpen.classList.toggle('hidden', open);
						if (iconClose) iconClose.classList.toggle('hidden', !open);
					});
				})();
			</script>
		</header>

		<main class="flex-1"> {% block body %}{% endblock %}
			</main>

			{% include 'partials/_footer.html.twig' %}

		{# Bandeau installation PWA — mobile, hors mode standalone #}
		<div id="pwa-install-banner"
			 class="md:hidden fixed left-3 right-3 z-60 hidden"
			 style="bottom: calc(4.25rem + env(safe-area-inset-bottom, 0px));"
			 role="dialog"
			 aria-live="polite"
			 aria-label="Installer l'application"
			 hidden>
			<div class="relative flex items-start gap-3 rounded-2xl border border-neutral-800 bg-black px-3.5 py-3 shadow-[0_8px_30px_rgba(0,0,0,0.55)]">
				<img src="{{ asset('build/images/icon-192.png') }}" alt="" class="mt-0.5 h-10 w-10 shrink-0 rounded-xl border border-neutral-800 object-cover" width="40" height="40">
				<div class="min-w-0 flex-1 pr-6">
					<p class="text-sm font-bold text-[#FFD700]">Studio Danse 430</p>
					<p id="pwa-install-android" class="mt-0.5 hidden text-xs leading-relaxed text-neutral-300">
						Installez l’app pour un accès rapide depuis votre écran d’accueil.
					</p>
					<p id="pwa-install-ios" class="mt-0.5 hidden text-xs leading-relaxed text-neutral-300">
						Appuyez sur <strong class="text-white">Partager</strong> 📤 puis
						<strong class="text-white">Sur l’écran d’accueil</strong>.
					</p>
					<button type="button"
							id="pwa-install-btn"
							class="mt-2.5 hidden items-center rounded-full bg-[#FFD700] px-3.5 py-1.5 text-xs font-extrabold text-black transition-colors hover:bg-yellow-400">
						Installer l’application
					</button>
				</div>
				<button type="button"
						id="pwa-install-dismiss"
						class="absolute right-2 top-2 inline-flex h-7 w-7 items-center justify-center rounded-full text-neutral-500 transition-colors hover:bg-neutral-900 hover:text-white"
						aria-label="Fermer">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
					</svg>
				</button>
			</div>
		</div>

		{# Bottom navigation — mobile only #}
		<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-black border-t border-neutral-800 pb-[env(safe-area-inset-bottom)]"
			 aria-label="Navigation rapide">
			<div class="grid grid-cols-4 h-16">
				<a href="{{ path('app_home') }}"
				   class="flex flex-col items-center justify-center gap-0.5 text-[10px] font-semibold transition-colors {{ currentRoute == 'app_home' ? 'text-[#FFD700]' : 'text-neutral-400 hover:text-[#FFD700]' }}">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5Z"/>
					</svg>
					<span>Accueil</span>
				</a>
				<a href="{{ path('app_event_index') }}"
				   class="flex flex-col items-center justify-center gap-0.5 text-[10px] font-semibold transition-colors {{ currentRoute starts with 'app_event' ? 'text-[#FFD700]' : 'text-neutral-400 hover:text-[#FFD700]' }}">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M8 3v2m8-2v2M4 9h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm2 8h4m-4 4h8"/>
					</svg>
					<span>Événements</span>
				</a>
				<a href="{{ path('app_boutique_index') }}"
				   class="flex flex-col items-center justify-center gap-0.5 text-[10px] font-semibold transition-colors {{ currentRoute starts with 'app_boutique' ? 'text-[#FFD700]' : 'text-neutral-400 hover:text-[#FFD700]' }}">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16l-1.2 11.2A2 2 0 0 1 16.81 20H7.19a2 2 0 0 1-1.99-1.8L4 7Zm4-3h8l1 3H7l1-3Z"/>
					</svg>
					<span>Boutique</span>
				</a>
				<a href="{{ accountPath }}"
				   class="flex flex-col items-center justify-center gap-0.5 text-[10px] font-semibold transition-colors {{ currentRoute starts with 'app_foyer' or currentRoute == 'app_login' or currentRoute starts with 'app_billets' ? 'text-[#FFD700]' : 'text-neutral-400 hover:text-[#FFD700]' }}">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 20a8 8 0 0 1 16 0"/>
					</svg>
					<span>Mon Compte</span>
				</a>
			</div>
		</nav>

		<script>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', function () {
					navigator.serviceWorker.register('/sw.js').catch(function () {});
				});
			}

			(function () {
				var STORAGE_KEY = 'sd430-pwa-install-dismissed';
				var banner = document.getElementById('pwa-install-banner');
				var btnInstall = document.getElementById('pwa-install-btn');
				var btnDismiss = document.getElementById('pwa-install-dismiss');
				var msgAndroid = document.getElementById('pwa-install-android');
				var msgIos = document.getElementById('pwa-install-ios');
				if (!banner || !btnDismiss) return;

				function isStandalone() {
					return window.matchMedia('(display-mode: standalone)').matches
						|| window.navigator.standalone === true;
				}

				function isMobileViewport() {
					return window.matchMedia('(max-width: 767px)').matches;
				}

				function isIos() {
					var ua = window.navigator.userAgent || '';
					return /iPad|iPhone|iPod/.test(ua)
						|| (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
				}

				function isSafari() {
					var ua = window.navigator.userAgent || '';
					return /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS|Chrome|Android/.test(ua);
				}

				function hideBanner() {
					banner.classList.add('hidden');
					banner.setAttribute('hidden', '');
				}

				function showBanner() {
					banner.classList.remove('hidden');
					banner.removeAttribute('hidden');
				}

				if (isStandalone() || !isMobileViewport() || localStorage.getItem(STORAGE_KEY) === '1') {
					return;
				}

				var deferredPrompt = null;

				window.addEventListener('beforeinstallprompt', function (event) {
					event.preventDefault();
					deferredPrompt = event;
					if (msgAndroid) msgAndroid.classList.remove('hidden');
					if (msgIos) msgIos.classList.add('hidden');
					if (btnInstall) btnInstall.classList.remove('hidden');
					showBanner();
				});

				if (btnInstall) {
					btnInstall.addEventListener('click', function () {
						if (!deferredPrompt) return;
						deferredPrompt.prompt();
						deferredPrompt.userChoice.finally(function () {
							deferredPrompt = null;
							hideBanner();
						});
					});
				}

				btnDismiss.addEventListener('click', function () {
					localStorage.setItem(STORAGE_KEY, '1');
					hideBanner();
				});

				window.addEventListener('appinstalled', function () {
					localStorage.setItem(STORAGE_KEY, '1');
					hideBanner();
				});

				// iOS Safari : pas de beforeinstallprompt — bulle d’aide discrète
				if (isIos() && isSafari()) {
					if (msgIos) msgIos.classList.remove('hidden');
					if (msgAndroid) msgAndroid.classList.add('hidden');
					if (btnInstall) btnInstall.classList.add('hidden');
					showBanner();
				}
			})();
		</script>
		</body>
	</html>
