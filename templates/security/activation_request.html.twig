{% extends 'base.html.twig' %}

{% block title %}Première connexion — Studio Danse 430{% endblock %}

{% block body %}
<section class="bg-black py-20 min-h-[70vh] flex items-center">
    <div class="max-w-md mx-auto w-full px-4 sm:px-6">
        <div class="text-center mb-8">
            <h1 class="text-4xl font-extrabold text-[#FFD700]">Première connexion</h1>
            <p class="mt-3 text-white/70">
                Adhérents officiels : activez votre compte importé avec l'e-mail transmis par le club.
            </p>
        </div>

        <div class="bg-black border border-[#FFD700]/40 rounded-3xl p-8 shadow-[0_0_30px_rgba(255,215,0,0.12)]">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-6 rounded-lg px-4 py-3 text-sm
                        {% if label == 'success' %}border border-emerald-500/60 bg-emerald-500/10 text-emerald-300
                        {% elseif label == 'warning' or label == 'info' %}border border-amber-500/60 bg-amber-500/10 text-amber-300
                        {% else %}border border-rose-500/60 bg-rose-500/10 text-rose-300{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {{ form_start(activationForm, { attr: { class: 'space-y-6' } }) }}
                <div>
                    {{ form_label(activationForm.email, null, { label_attr: { class: 'block text-sm font-semibold text-[#FFD700] mb-2' } }) }}
                    {{ form_widget(activationForm.email, {
                        attr: { class: 'w-full bg-black border border-[#FFD700] rounded-lg px-4 py-3 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#FFD700]' }
                    }) }}
                    {{ form_errors(activationForm.email) }}
                </div>
                {{ form_rest(activationForm) }}
                <button type="submit" class="w-full px-8 py-4 bg-[#FFD700] text-black font-bold rounded-full hover:bg-yellow-400 transition-colors">
                    Recevoir le lien d'activation
                </button>
            {{ form_end(activationForm) }}

            <div class="mt-6 text-center text-sm text-white/60 space-y-2">
                <p>Nouveau membre (non importé) ?</p>
                <a href="{{ path('app_register') }}" class="text-[#FFD700] hover:underline font-semibold">Créer un compte — inscription classique</a>
                <p class="pt-2">
                    <a href="{{ path('app_login') }}" class="hover:text-[#FFD700]">Retour à la connexion</a>
                </p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
