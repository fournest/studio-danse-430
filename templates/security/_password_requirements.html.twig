<ul id="password-requirements-{{ input_id|default('password') }}" class="mt-2 space-y-1 text-xs text-white/60">
    <li data-rule="length" class="flex items-center gap-2"><span class="rule-icon">○</span> Au moins 8 caractères</li>
    <li data-rule="upper" class="flex items-center gap-2"><span class="rule-icon">○</span> Au moins une majuscule (A-Z)</li>
    <li data-rule="lower" class="flex items-center gap-2"><span class="rule-icon">○</span> Au moins une minuscule (a-z)</li>
    <li data-rule="digit" class="flex items-center gap-2"><span class="rule-icon">○</span> Au moins un chiffre (0-9)</li>
    <li data-rule="special" class="flex items-center gap-2"><span class="rule-icon">○</span> Au moins un caractère spécial (!@#$…)</li>
</ul>
<script>
(function () {
    const input = document.getElementById('{{ input_id|default('password') }}');
    const list = document.getElementById('password-requirements-{{ input_id|default('password') }}');
    if (!input || !list) return;

    const rules = {
        length: v => v.length >= 8,
        upper: v => /[A-Z]/.test(v),
        lower: v => /[a-z]/.test(v),
        digit: v => /\d/.test(v),
        special: v => /[^A-Za-z0-9]/.test(v),
    };

    function update() {
        const v = input.value;
        list.querySelectorAll('[data-rule]').forEach(li => {
            const ok = rules[li.dataset.rule](v);
            li.classList.toggle('text-emerald-400', ok);
            li.classList.toggle('text-white/60', !ok);
            li.querySelector('.rule-icon').textContent = ok ? '✓' : '○';
        });
    }

    input.addEventListener('input', update);
    update();
})();
</script>
