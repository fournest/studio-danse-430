{% extends 'base.html.twig' %}

{% block title %}Connexion - Studio Danse 430
{% endblock %}

{% block body %}
	<section class="bg-black py-20 min-h-[70vh] flex items-center">
		<div class="max-w-md mx-auto w-full px-4 sm:px-6">
			<div class="text-center mb-8">
				<h1 class="text-4xl font-extrabold text-[#FFD700]">Connexion</h1>
				<p class="mt-3 text-white/70">Accédez à votre espace Studio Danse 430.</p>
			</div>

			<div class="bg-black border border-[#FFD700]/40 rounded-3xl p-8 shadow-[0_0_30px_rgba(255,215,0,0.12)]">
				{% if error %}
					<div class="mb-6 rounded-lg border border-rose-500/60 bg-rose-500/10 px-4 py-3 text-rose-300 text-sm">
						{{ error.messageKey|trans(error.messageData, 'security') }}
					</div>
				{% endif %}

				{% if app.user %}
					<div class="mb-6 rounded-lg border border-[#FFD700] bg-[#FFD700]/10 px-4 py-3 text-[#FFD700] text-sm">
						Vous êtes connecté en tant que
						{{ app.user.userIdentifier }}.
					</div>
				{% endif %}

				<form method="post" class="space-y-6">
					<div>
						<label for="inputEmail" class="block text-sm font-semibold text-[#FFD700] mb-2">Adresse e-mail</label>
						<input type="email" id="inputEmail" name="email" value="{{ last_username }}" autocomplete="email" required autofocus placeholder="vous@exemple.fr" class="w-full bg-black border border-[#FFD700] rounded-lg px-4 py-3 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#FFD700] focus:border-[#FFD700] transition">
					</div>

					<div class="relative">
						<label for="inputPassword" class="block text-sm font-semibold text-[#FFD700] mb-2">Mot de passe</label>
						<input
						type="password" id="inputPassword" name="password" autocomplete="current-password" required placeholder="••••••••" class="w-full bg-black border border-[#FFD700] rounded-lg px-4 py-3 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#FFD700] transition">

						<!-- Bouton Toggle -->
						<button type="button" onclick="togglePassword()" class="absolute right-3 top-11 text-[#FFD700] hover:bg-black/50 rounded-lg p-2">
							<svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 20 20" fill="currentColor">
								<path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
								<path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM10 15a5 5 0 100-10 5 5 0 000 10z" clip-rule="evenodd"/>
							</svg>
						</button>
					</div>

					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<button type="submit" class="w-full px-8 py-4 bg-[#FFD700] text-black font-bold rounded-full hover:bg-yellow-400 transition-colors duration-200 shadow-lg">
						Se connecter
					</button>
					<div class="text-center mt-4">
						<a href="{{ path('app_forgot_password_request') }}" class="text-xs text-white/60 hover:text-[#FFD700]">
							Mot de passe oublié ?
						</a>
					</div>
					{% if error %}
						<div class="mb-6 rounded-lg border border-rose-500/60 bg-rose-500/10 px-4 py-3 text-rose-300 text-sm">
							{% if error.messageKey == 'Account is disabled' %}
								Votre compte est désactivé. Veuillez contacter le bureau du Studio Danse 430 pour le réactiver.
							{% else %}
								Identifiants ou mot de passe incorrects.
							{% endif %}
						</div>
					{% endif %}
				</form>
			</div>
		</div>
	</section>
	<script>
		function togglePassword() {
const input = document.getElementById('inputPassword');
const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
input.setAttribute('type', type);
}
	</script>
{% endblock %}
