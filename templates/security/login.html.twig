{% extends 'base.html.twig' %}

{% block title %}Connexion - Studio Danse 430{% endblock %}

{% block body %}
    <section class="bg-black py-20 min-h-[70vh] flex items-center">
        <div class="max-w-md mx-auto w-full px-4 sm:px-6">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-extrabold text-[#FFD700]">Connexion</h1>
                <p class="mt-3 text-white/70">Accédez à votre espace Studio Danse 430.</p>
            </div>

            <div class="bg-black border border-[#FFD700]/40 rounded-3xl p-8 shadow-[0_0_30px_rgba(255,215,0,0.12)]">
                {% if error %}
                    <div class="mb-6 rounded-lg border border-rose-500/60 bg-rose-500/10 px-4 py-3 text-rose-300 text-sm">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-6 rounded-lg border border-[#FFD700] bg-[#FFD700]/10 px-4 py-3 text-[#FFD700] text-sm">
                        Vous êtes connecté en tant que {{ app.user.userIdentifier }}.
                    </div>
                {% endif %}

                <form method="post" class="space-y-6">
                    <div>
                        <label for="inputEmail" class="block text-sm font-semibold text-[#FFD700] mb-2">Adresse e-mail</label>
                        <input type="email" id="inputEmail" name="email" value="{{ last_username }}"
                               autocomplete="email" required autofocus
                               placeholder="vous@exemple.fr"
                               class="w-full bg-black border border-[#FFD700] rounded-lg px-4 py-3 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#FFD700] focus:border-[#FFD700] transition">
                    </div>

                    <div>
                        <label for="inputPassword" class="block text-sm font-semibold text-[#FFD700] mb-2">Mot de passe</label>
                        <input type="password" id="inputPassword" name="password"
                               autocomplete="current-password" required
                               placeholder="••••••••"
                               class="w-full bg-black border border-[#FFD700] rounded-lg px-4 py-3 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#FFD700] focus:border-[#FFD700] transition">
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit"
                            class="w-full px-8 py-4 bg-[#FFD700] text-black font-bold rounded-full hover:bg-yellow-400 transition-colors duration-200 shadow-lg">
                        Se connecter
                    </button>
                </form>
            </div>

            <p class="text-center text-white/50 text-sm mt-6">
                Un souci de connexion ? Contactez le secrétariat du studio.
            </p>
        </div>
    </section>
{% endblock %}
