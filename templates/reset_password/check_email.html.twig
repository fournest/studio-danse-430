{% extends 'base.html.twig' %}

{% block title %}Email envoyé - Studio Danse 430{% endblock %}

{% block body %}
    <section class="bg-black py-20 min-h-[70vh] flex items-center">
        <div class="max-w-md mx-auto w-full px-4 sm:px-6">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-extrabold text-[#FFD700]">Email envoyé</h1>
            </div>

            <div class="bg-black border border-[#FFD700]/40 rounded-3xl p-8 shadow-[0_0_30px_rgba(255,215,0,0.12)] text-center">
                <p class="text-white mb-6">
                    Si un compte correspond à cette adresse e-mail, un message vient d'être envoyé contenant un lien pour réinitialiser votre mot de passe.
                </p>
                
                <p class="text-white/70 text-sm mb-6">
                    Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                </p>

                <div class="pt-6 border-t border-[#FFD700]/20">
                    <p class="text-white/60 text-sm">
                        Vous n'avez pas reçu l'e-mail ? Vérifiez vos courriers indésirables ou 
                        <a href="{{ path('app_forgot_password_request') }}" class="text-[#FFD700] hover:underline font-semibold">réessayez</a>.
                    </p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}