{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Studio Danse 430{% endblock %}

{% block body %}
    <section class="bg-black py-20 min-h-[70vh] flex items-center">
        <div class="max-w-md mx-auto w-full px-4 sm:px-6">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-extrabold text-[#FFD700]">Mot de passe oublié</h1>
                <p class="mt-3 text-white/70">Entrez votre email pour recevoir le lien de réinitialisation.</p>
            </div>

            <div class="bg-black border border-[#FFD700]/40 rounded-3xl p-8 shadow-[0_0_30px_rgba(255,215,0,0.12)]">
                
                {# Gestion des erreurs (les flash messages) #}
                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="mb-6 rounded-lg border border-rose-500/60 bg-rose-500/10 px-4 py-3 text-rose-300 text-sm">
                        {{ flash_error }}
                    </div>
                {% endfor %}

                {{ form_start(requestForm, {'attr': {'class': 'space-y-6'}}) }}
                    <div>
                        {{ form_label(requestForm.email, 'Adresse e-mail', {'label_attr': {'class': 'block text-sm font-semibold text-[#FFD700] mb-2'}}) }}
                        {{ form_widget(requestForm.email, {'attr': {
                            'class': 'w-full bg-black border border-[#FFD700] rounded-lg px-4 py-3 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-[#FFD700] transition',
                            'placeholder': 'vous@exemple.fr'
                        }}) }}
                    </div>

                    <div>
                        <p class="text-xs text-white/60">
                            Entrez votre adresse e-mail, et nous vous enverrons un lien pour réinitialiser votre mot de passe.
                        </p>
                    </div>

                    <button type="submit" class="w-full px-8 py-4 bg-[#FFD700] text-black font-bold rounded-full hover:bg-yellow-400 transition-colors duration-200 shadow-lg">
                        Envoyer l'email
                    </button>
                {{ form_end(requestForm) }}
            </div>
        </div>
    </section>
{% endblock %}