{% extends 'base.html.twig' %}

{% block title %}Studio Danse 430 - École de danse depuis 1976
{% endblock %}

{% block body %}
	{# ===== Section Hero ===== #}
	<section
		class="relative overflow-hidden">
		{# Image de fond noir & blanc du studio #}
		<div class="absolute inset-0 bg-black bg-cover bg-center bg-no-repeat" style="background-image: url('{{ asset('images/fond-ecran-studio-danse-430.jpg') }}');"></div>
		{# Overlay d'assombrissement #}
		<div class="absolute inset-0 bg-black/60"></div>
		<div class="absolute inset-0 bg-linear-to-b from-black/30 via-black/50 to-black"></div>

		<div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-28 sm:py-36 text-center">
			<h1 class="text-5xl sm:text-7xl font-extrabold tracking-tight text-[#FFD700] drop-shadow-lg">
				Studio Danse 430
			</h1>
			<p class="mt-6 text-lg sm:text-2xl text-white/90 max-w-2xl mx-auto">
				L'excellence de la danse depuis 1976. Vivez la passion sur scène et en cours.
			</p>

			<div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="{{ path('app_gala_reservation') }}" class="w-full sm:w-auto px-8 py-4 bg-[#FFD700] text-black font-bold rounded-full hover:bg-yellow-400 transition-colors duration-200 shadow-lg">
					Réserver Places Gala
				</a>
				<a href="{{ path('app_inscription') }}" class="w-full sm:w-auto px-8 py-4 bg-white text-black font-bold rounded-full hover:bg-gray-200 transition-colors duration-200 shadow-lg">
					S'inscrire
				</a>
				<a href="{{ path('app_galerie_index') }}" class="inline-flex items-center justify-center px-6 py-3 bg-amber-400 hover:bg-amber-500 text-black font-bold rounded-full transition shadow-md">
					<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2 2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
					</svg>
					Galerie Photos & Vidéos
				</a>
			</div>
		</div>
	</section>

			{# ===== Section Mixte : Cours & Actualités ===== #}
	<section class="bg-black py-20 border-b border-neutral-900">
		<div class="max-w-7xl mx-auto px-4 sm:px-6">

			<div class="text-center mb-16">
				<h2 class="text-4xl font-extrabold text-[#FFD700]">Vie du Club & Horaires</h2>
				<p class="mt-4 text-white/70 max-w-2xl mx-auto">
					Retrouvez le planning de nos cours ainsi que les dernières actualités du studio.
				</p>
			</div>

			<div class="flex flex-col lg:flex-row gap-10 items-start">

				<div class="flex-1 w-full space-y-8">
					<h3 class="text-2xl font-bold text-white flex items-center gap-2 border-b border-neutral-900 pb-3">
						<span class="text-[#FFD700]">🩰</span>
						Les Disciplines
					</h3>

					{% if disciplines is empty %}
						<div class="text-center py-16 border border-[#FFD700]/30 rounded-2xl bg-neutral-950/40">
							<p class="text-white/60 text-lg">Le planning des cours sera bientôt disponible.</p>
						</div>
					{% else %}
						<div class="grid gap-6 sm:grid-cols-2">
							{% for discipline in disciplines %}
								{% include 'cours/_discipline_card.html.twig' with { discipline: discipline } only %}
							{% endfor %}
						</div>

						{% include 'partials/_remarque_pedagogique.html.twig' %}

						<div class="pt-2">
							<a href="{{ path('app_cours_index') }}" class="inline-block px-6 py-3 border border-neutral-800 text-neutral-300 font-semibold rounded-full hover:border-white hover:text-white transition duration-200">
								Voir la totalité du planning →
							</a>
						</div>
					{% endif %}
				</div>

			</div>

			{# Cartes actualités (3 dernières publiées) #}
			<div class="mt-16 pt-12 border-t border-neutral-900">
				<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8">
					<div>
						<h3 class="text-2xl font-bold text-white flex items-center gap-2">
							<span class="text-[#FFD700]">📢</span>
							Actualités
						</h3>
						<p class="mt-1 text-sm text-neutral-500">Les dernières nouvelles du club</p>
					</div>
					<a href="{{ path('app_actualite_index') }}" class="text-sm font-semibold text-[#FFD700] hover:underline">
						Toutes les actualités →
					</a>
				</div>

				{% if actualites is empty %}
					<div class="text-center py-12 border border-dashed border-neutral-800 rounded-2xl">
						<p class="text-sm text-neutral-500 italic">Aucune actualité publiée pour le moment.</p>
					</div>
				{% else %}
					<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{% for actu in actualites %}
							{% include 'actualite/_card.html.twig' with { actu: actu } only %}
						{% endfor %}
					</div>
				{% endif %}
			</div>
		</div>
	</section>

	{# ===== Section À propos ===== #}
	<section class="bg-black py-20">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
			<h2 class="text-4xl font-extrabold text-[#FFD700] mb-8">À propos</h2>
			<div class="space-y-6 text-lg text-white/85 leading-relaxed">
				<p>
					Fondé en
					<span class="text-[#FFD700] font-semibold">1976</span>, le Studio Danse 430 transmet depuis près de cinquante ans l'amour de la danse à des générations de passionnés.
				</p>
				<p>
					De la première barre aux grandes scènes de gala, notre école a grandi sans jamais renier ses valeurs : l'exigence du geste, le respect de chacun et la joie de danser ensemble.
				</p>
				<p>
					Aujourd'hui encore, nos professeurs accompagnent chaque danseur, enfant ou adulte, débutant ou confirmé, dans un cadre chaleureux et premium.
				</p>
			</div>
		</div>
	</section>

	{# ===== Bandeau des Sponsors ===== #}
	<div class="w-full bg-neutral-950 border-t border-neutral-900 py-8 overflow-hidden select-none" style="background-color: #0a0a0a !important;">
		<div class="text-center mb-6">
			<span class="text-xs font-semibold tracking-widest text-amber-500 uppercase">Ils soutiennent le club</span>
		</div>

		<div class="flex animate-marquee whitespace-nowrap items-center hover:[animation-play-state:paused] w-max gap-8">
			<div class="flex items-center shrink-0 gap-8">
				{% for sponsor in sponsors %}
					<a href="{{ sponsor.lien ?? '#' }}" target="_blank" rel="noopener noreferrer" class="shrink-0 block">
						<img src="{{ asset('/uploads/logos/sponsors/' ~ sponsor.logo) }}" alt="{{ sponsor.nom }}" class="h-20 w-auto max-w-none object-contain grayscale opacity-75 hover:grayscale-0 hover:opacity-100 transition-all duration-300" onerror="this.style.display='none'">
					</a>
				{% endfor %}
			</div>

			<!-- Le clone pour l'effet de boucle infinie -->
			<div class="flex items-center shrink-0 gap-8" aria-hidden="true">
				{% for sponsor in sponsors %}
					<a href="{{ sponsor.lien ?? '#' }}" target="_blank" rel="noopener noreferrer" class="shrink-0 block">
						<img src="{{ asset('/uploads/logos/sponsors/' ~ sponsor.logo) }}" alt="{{ sponsor.nom }}" class="h-20 w-auto max-w-none object-contain grayscale opacity-75 hover:grayscale-0 hover:opacity-100 transition-all duration-300" onerror="this.style.display='none'">
					</a>
				{% endfor %}
			</div>
		</div>
	</div>

	{# CSS pour l'animation du bandeau #}
	<style>
		@keyframes marquee {
			from {
				transform: translateX(0%);
			}
			to {
				transform: translateX(-50%);
			}
		}
		.animate-marquee {
			animation: marquee 25s linear infinite;
			display: flex;
			width: max-content;
		}

		.animate-marquee:hover {
			animation-play-state: paused;
		}
		input:-webkit-autofill,
		input:-webkit-autofill:hover,
		input:-webkit-autofill:focus {
			-webkit-box-shadow: 0 0 0 1000px #000 inset !important;
			-webkit-text-fill-color: #fff !important;
			transition: background-color 5000s ease-in-out 0s;
		}
	</style>
{% endblock %}
