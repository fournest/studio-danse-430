{% extends 'base.html.twig' %}

{% block title %}Règlement — Cotisation foyer — Studio Danse 430{% endblock %}

{% block body %}
<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] text-white">
    <div class="max-w-3xl mx-auto space-y-8" id="paiement-app"
         data-montant-total="{{ montantTotal }}"
         data-reste-a-payer="{{ resteAPayer }}"
         data-dates-par-option="{{ datesParOption|json_encode|e('html_attr') }}"
         data-libelle-virement="{{ libelleVirement|default('')|e('html_attr') }}"
         data-turbo="false">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="p-4 rounded-md {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : (label == 'warning' ? 'bg-amber-950/50 border border-amber-800 text-amber-300' : 'bg-red-950/50 border border-red-800 text-red-400') }} text-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="border-b border-neutral-800 pb-6">
            <p class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">
                <a href="{{ path('app_foyer_index') }}" class="hover:text-[#FFD700] transition-colors">← Mon foyer</a>
            </p>
            <h1 class="text-3xl font-extrabold text-[#FFD700] tracking-tight">Modes de paiement</h1>
            <p class="text-neutral-400 mt-1">
                Cotisation foyer — saison {{ inscription.saison }}
                {% if cotisation is defined and cotisation and cotisation.payingCoursesCount > 1 %}
                    <span class="text-neutral-600">·</span> {{ cotisation.payingCoursesCount }} cours
                {% endif %}
            </p>
        </div>

        <div class="bg-neutral-900/60 border border-[#FFD700]/30 rounded-xl p-6 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-neutral-500">Grand total foyer à régler</p>
                    <p class="text-4xl font-extrabold text-[#FFD700] mt-1">
                        {{ montantTotal|number_format(2, ',', ' ') }} €
                    </p>
                    {% if cotisation is defined and cotisation %}
                        <div class="mt-3 space-y-1 text-sm text-neutral-400">
                            <p>Cotisation cours : <span class="text-white">{{ cotisation.total|number_format(2, ',', ' ') }} €</span>
                                {% if cotisation.foyerDiscountPercentage > 0 %}
                                    <span class="text-[#FFD700]/80 font-semibold">(−{{ cotisation.foyerDiscountPercentage }} %)</span>
                                {% endif %}
                            </p>
                            <p class="text-xs text-neutral-500">Boutique et costumes se règlent séparément.</p>
                        </div>
                    {% endif %}
                </div>
                <div class="text-sm text-neutral-300 space-y-1 sm:text-right">
                    <p>Aides / déductions : <span class="text-white font-semibold" id="recap-deductions">0,00 €</span></p>
                    <p>Solde à échelonner : <span class="text-[#FFD700] font-extrabold" id="recap-solde">{{ resteAPayer|number_format(2, ',', ' ') }} €</span></p>
                </div>
            </div>
            <p class="text-xs text-neutral-500 flex flex-wrap gap-x-4 gap-y-1">
                <a href="{{ path('app_boutique_index') }}" class="hover:text-[#FFD700] transition-colors">Boutique →</a>
                <a href="{{ path('app_costumes_index') }}" class="hover:text-[#FFD700] transition-colors">Location costumes →</a>
            </p>
        </div>

        {% if paiementsExistants is not empty %}
            <div class="bg-amber-950/20 border border-amber-800/40 rounded-xl p-4 text-sm text-amber-200">
                <p class="font-semibold mb-2">Des moyens de paiement sont déjà enregistrés ({{ paiementsExistants|length }} ligne(s)).</p>
                <p class="text-amber-200/70">Les remplacer en validant à nouveau le formulaire ci-dessous.</p>
            </div>
        {% endif %}

        <form method="post" id="paiement-form" class="space-y-6">
            <input type="hidden" name="_token" value="{{ csrf_token('inscription_paiement' ~ inscription.id) }}">

            {# --- 1. Aides / déductions (optionnel) --- #}
            <section class="bg-neutral-900/60 border border-neutral-800 rounded-xl p-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                    <div>
                        <h2 class="text-sm font-bold uppercase tracking-wider text-neutral-500">1. Aides &amp; autres règlements</h2>
                        <p class="text-sm text-neutral-400 mt-1">
                            Optionnel — soustrayez Pass’Sport, chèques vacances ANCV, espèces… avant d’échelonner le solde.
                        </p>
                    </div>
                    <button type="button" id="btn-add-deduction"
                            class="shrink-0 text-xs font-bold uppercase tracking-wider text-[#FFD700] hover:underline">
                        + Ajouter une aide
                    </button>
                </div>
                <div id="deductions-container" class="space-y-3"></div>
                <template id="deduction-template">
                    <div class="grid gap-3 sm:grid-cols-12 items-end p-3 rounded-lg border border-neutral-800 bg-black/30 js-deduction">
                        <div class="sm:col-span-4">
                            <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Type</label>
                            <select name="deductions[__INDEX__][mode]" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 text-white px-3 py-2">
                                {% for mode in modesDeduction %}
                                    <option value="{{ mode.value }}">{{ mode.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="sm:col-span-3">
                            <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Montant (€)</label>
                            <input type="number" step="0.01" min="0.01" name="deductions[__INDEX__][montant]"
                                   class="w-full rounded-lg bg-zinc-900 border border-zinc-700 text-white px-3 py-2 js-deduction-montant"
                                   value="">
                        </div>
                        <div class="sm:col-span-4">
                            <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Référence / Note</label>
                            <input type="text" name="deductions[__INDEX__][reference]"
                                   class="w-full rounded-lg bg-zinc-900 border border-zinc-700 text-white px-3 py-2 js-deduction-ref"
                                   placeholder="Code Pass’Sport, n°…">
                        </div>
                        <div class="sm:col-span-1 flex justify-end pb-1">
                            <button type="button" class="js-remove-deduction text-red-400 hover:text-red-300 text-lg leading-none" title="Supprimer">×</button>
                        </div>
                    </div>
                </template>
            </section>

            {# --- 2. Solde à échelonner --- #}
            <section id="panel-echelonne" class="bg-neutral-900/60 border border-neutral-800 rounded-xl p-6 space-y-5">
                <div>
                    <h2 class="text-sm font-bold uppercase tracking-wider text-neutral-500">2. Solde à échelonner</h2>
                    <p class="text-sm text-neutral-400 mt-1">
                        Le reste après aides est réglé en chèques ou virements (1×, 3× ou 10×).
                    </p>
                    <p class="text-lg font-extrabold text-[#FFD700] mt-3" id="solde-affiche">
                        {{ resteAPayer|number_format(2, ',', ' ') }} €
                    </p>
                    <input type="hidden" name="montant_echelonne" id="montant_echelonne" value="{{ resteAPayer|number_format(2, '.', '') }}">
                </div>

                <div id="bloc-echelonnement-options" class="space-y-5">
                    <div>
                        <p class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">Moyen d’échéance</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex items-center gap-3 px-4 py-3 rounded-lg border border-neutral-700 cursor-pointer has-checked:border-[#FFD700] has-checked:bg-[#FFD700]/10">
                                <input type="radio" name="mode_echeance" value="cheque" class="accent-[#FFD700] js-mode-echeance" checked id="mode-cheque">
                                <span class="text-sm font-semibold">💳 Chèque(s)</span>
                            </label>
                            <label class="flex items-center gap-3 px-4 py-3 rounded-lg border border-neutral-700 cursor-pointer has-checked:border-[#FFD700] has-checked:bg-[#FFD700]/10">
                                <input type="radio" name="mode_echeance" value="virement" class="accent-[#FFD700] js-mode-echeance" id="mode-virement">
                                <span class="text-sm font-semibold">🏦 Virement(s)</span>
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">Nombre d’échéances</label>
                        <div class="flex flex-wrap gap-3">
                            {% for n in [1, 3, 10] %}
                                <label class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-neutral-700 cursor-pointer has-checked:border-[#FFD700] has-checked:bg-[#FFD700]/10">
                                    <input type="radio" name="nombre_echeances" value="{{ n }}" class="accent-[#FFD700] js-echeances" {{ n == 1 ? 'checked' : '' }}>
                                    <span class="text-sm font-semibold">{{ n }}×</span>
                                </label>
                            {% endfor %}
                        </div>
                        <p class="text-xs text-neutral-500 mt-2" id="echeances-hint">1 échéance le 10 octobre.</p>
                    </div>

                    <div id="bloc-cheque" class="space-y-4">
                        <div>
                            <label for="emetteur" class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Nom de l’émetteur du chèque</label>
                            <input type="text" name="emetteur" id="emetteur"
                                   class="w-full rounded-lg bg-zinc-900 border border-zinc-700 text-white px-3 py-2 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
                                   placeholder="Ex. Nom du parent qui signe le(s) chèque(s)"
                                   value="">
                        </div>
                        <div class="rounded-lg border border-amber-800/40 bg-amber-950/20 px-4 py-3 text-sm text-amber-100/90 leading-relaxed">
                            Merci de remettre l’ensemble des chèques / espèces sous enveloppe au nom du foyer,
                            lors des permanences de rentrée (indiquez le nom de la famille au dos / sur l’enveloppe).
                        </div>
                    </div>

                    <div id="bloc-virement" class="space-y-4 hidden">
                        <div class="rounded-lg border border-neutral-700 bg-black/40 p-4 space-y-3 text-sm">
                            <p class="text-xs font-bold uppercase tracking-wider text-neutral-500">Coordonnées bancaires du club</p>
                            {% if club_iban %}
                                <dl class="space-y-2">
                                    <div class="flex flex-col sm:flex-row sm:gap-3">
                                        <dt class="text-neutral-500 sm:w-28 shrink-0">Titulaire</dt>
                                        <dd class="text-white font-medium">{{ club_titulaire|default('Studio Danse 430') }}</dd>
                                    </div>
                                    <div class="flex flex-col sm:flex-row sm:gap-3">
                                        <dt class="text-neutral-500 sm:w-28 shrink-0">IBAN</dt>
                                        <dd class="text-[#FFD700] font-mono font-semibold tracking-wide break-all">{{ club_iban }}</dd>
                                    </div>
                                    <div class="flex flex-col sm:flex-row sm:gap-3">
                                        <dt class="text-neutral-500 sm:w-28 shrink-0">BIC</dt>
                                        <dd class="text-white font-mono">{{ club_bic }}</dd>
                                    </div>
                                </dl>
                            {% else %}
                                <p class="text-amber-300">Les coordonnées bancaires ne sont pas encore configurées. Contactez le bureau.</p>
                            {% endif %}
                        </div>

                        {% if libelleVirement %}
                            <div class="rounded-lg border border-[#FFD700]/40 bg-[#FFD700]/10 px-4 py-3">
                                <p class="text-xs font-bold uppercase tracking-wider text-[#FFD700]/80 mb-1">Libellé de virement obligatoire</p>
                                <p class="text-lg font-extrabold text-[#FFD700] font-mono tracking-wide break-all">{{ libelleVirement }}</p>
                                <p class="text-xs text-neutral-400 mt-1">Inscrivez exactement cet intitulé sur chaque virement.</p>
                            </div>
                        {% endif %}

                        <div class="rounded-lg border border-sky-800/40 bg-sky-950/20 px-4 py-3 text-sm text-sky-100/90 leading-relaxed">
                            Merci de programmer vos virements automatiques sur votre banque en ligne aux dates indiquées ci-dessous avec le libellé exact.
                        </div>
                    </div>

                    <div>
                        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">Tableau des échéances</h3>
                        <div class="overflow-x-auto rounded-lg border border-neutral-800">
                            <table class="w-full text-sm">
                                <thead class="bg-black/40 text-neutral-400 text-left">
                                    <tr>
                                        <th class="px-3 py-2 font-semibold">#</th>
                                        <th class="px-3 py-2 font-semibold" id="col-date-label">Date prévue</th>
                                        <th class="px-3 py-2 font-semibold text-right" id="col-montant-label">Montant</th>
                                    </tr>
                                </thead>
                                <tbody id="preview-echeances" class="divide-y divide-neutral-800 text-neutral-200"></tbody>
                                <tfoot class="border-t border-neutral-700 bg-black/30">
                                    <tr>
                                        <td colspan="2" class="px-3 py-2 text-neutral-400 font-semibold">Total échéances</td>
                                        <td class="px-3 py-2 text-right font-bold text-[#FFD700]" id="preview-total">0,00 €</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div id="bloc-solde-couvert" class="hidden rounded-lg border border-emerald-800/40 bg-emerald-950/20 px-4 py-3 text-sm text-emerald-200">
                    Les aides couvrent l’intégralité de la cotisation : aucun échéancier n’est nécessaire.
                </div>
            </section>

            <div class="flex flex-col sm:flex-row gap-3 sm:justify-end pt-2">
                <a href="{{ path('app_foyer_index') }}"
                   class="inline-flex justify-center px-5 py-2.5 rounded-md border border-neutral-700 text-sm font-semibold text-neutral-300 hover:border-neutral-500 transition-colors">
                    Plus tard
                </a>
                <button type="submit" id="btn-submit"
                        class="inline-flex justify-center px-5 py-2.5 rounded-md bg-[#FFD700] text-black text-sm font-bold uppercase tracking-wider hover:bg-amber-300 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                    Valider le règlement
                </button>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    const root = document.getElementById('paiement-app');
    if (!root) return;

    const resteAPayer = parseFloat(root.dataset.resteAPayer) || 0;
    let datesParOption = {};
    try {
        datesParOption = JSON.parse(root.dataset.datesParOption || '{}');
    } catch (e) {
        datesParOption = {};
    }

    const blocCheque = document.getElementById('bloc-cheque');
    const blocVirement = document.getElementById('bloc-virement');
    const blocOptions = document.getElementById('bloc-echelonnement-options');
    const blocSoldeCouvert = document.getElementById('bloc-solde-couvert');
    const modeCheque = document.getElementById('mode-cheque');
    const modeVirement = document.getElementById('mode-virement');
    const hint = document.getElementById('echeances-hint');
    const preview = document.getElementById('preview-echeances');
    const previewTotal = document.getElementById('preview-total');
    const colDateLabel = document.getElementById('col-date-label');
    const colMontantLabel = document.getElementById('col-montant-label');
    const montantInput = document.getElementById('montant_echelonne');
    const soldeAffiche = document.getElementById('solde-affiche');
    const recapDeductions = document.getElementById('recap-deductions');
    const recapSolde = document.getElementById('recap-solde');
    const btnSubmit = document.getElementById('btn-submit');
    const emetteur = document.getElementById('emetteur');
    const deductionsContainer = document.getElementById('deductions-container');
    const tpl = document.getElementById('deduction-template');
    let deductionIndex = 0;

    const hintsCheque = {
        1: '1 chèque encaissé le 10 octobre.',
        3: '3 chèques : 10 octobre, 10 janvier, 10 avril.',
        10: '10 chèques : le 10 de chaque mois d’octobre à juillet.'
    };
    const hintsVirement = {
        1: '1 virement à programmer pour le 10 octobre.',
        3: '3 virements : 10 octobre, 10 janvier, 10 avril.',
        10: '10 virements : le 10 de chaque mois d’octobre à juillet.'
    };

    function fmt(n) {
        return n.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' €';
    }

    function repartir(total, n) {
        const base = Math.round((total / n) * 100) / 100;
        const arr = Array(n).fill(base);
        const somme = Math.round(base * n * 100) / 100;
        const reste = Math.round((total - somme) * 100) / 100;
        arr[0] = Math.round((arr[0] + reste) * 100) / 100;
        return arr;
    }

    function getDeductionsTotal() {
        let sum = 0;
        deductionsContainer.querySelectorAll('.js-deduction-montant').forEach(function (input) {
            const v = parseFloat(String(input.value).replace(',', '.'));
            if (!isNaN(v) && v > 0) sum += v;
        });
        return Math.round(sum * 100) / 100;
    }

    function getSolde() {
        return Math.round(Math.max(0, resteAPayer - getDeductionsTotal()) * 100) / 100;
    }

    function isVirementMode() {
        return modeVirement && modeVirement.checked;
    }

    function updateModeEcheance() {
        const isVir = isVirementMode();
        blocCheque.classList.toggle('hidden', isVir);
        blocVirement.classList.toggle('hidden', !isVir);
        colDateLabel.textContent = isVir ? 'Date de virement' : 'Date d’encaissement';
        colMontantLabel.textContent = isVir ? 'Montant du virement' : 'Montant du chèque';
        updateEcheancesPreview();
        updateRecap();
    }

    function updateEcheancesPreview() {
        const solde = getSolde();
        const n = parseInt(document.querySelector('input[name="nombre_echeances"]:checked')?.value || '1', 10);
        const isVir = isVirementMode();
        hint.textContent = (isVir ? hintsVirement : hintsCheque)[n] || '';
        const parts = solde > 0 ? repartir(solde, n) : [];
        const dates = datesParOption[String(n)] || datesParOption[n] || [];

        preview.innerHTML = parts.map(function (m, i) {
            return '<tr>'
                + '<td class="px-3 py-2 text-neutral-500">' + (i + 1) + '/' + n + '</td>'
                + '<td class="px-3 py-2">' + (dates[i] || '—') + '</td>'
                + '<td class="px-3 py-2 text-right font-semibold text-[#FFD700]">' + fmt(m) + '</td>'
                + '</tr>';
        }).join('') || '<tr><td colspan="3" class="px-3 py-3 text-neutral-500">Aucune échéance — solde couvert par les aides.</td></tr>';
        previewTotal.textContent = fmt(solde);
    }

    function updateRecap() {
        const deductions = getDeductionsTotal();
        const solde = getSolde();
        const overflow = deductions - resteAPayer > 0.009;

        recapDeductions.textContent = fmt(deductions);
        recapSolde.textContent = fmt(solde);
        soldeAffiche.textContent = fmt(solde);
        montantInput.value = solde.toFixed(2);

        const soldeCouvert = solde < 0.009;
        blocOptions.classList.toggle('hidden', soldeCouvert);
        blocSoldeCouvert.classList.toggle('hidden', !soldeCouvert);

        if (soldeCouvert) {
            emetteur.required = false;
        } else {
            emetteur.required = !isVirementMode();
        }

        let ok = !overflow && (solde > 0.009 || deductions > 0.009);
        if (solde > 0.009 && !isVirementMode()) {
            ok = ok && emetteur.value.trim().length > 0;
        }

        btnSubmit.disabled = !ok;
        updateEcheancesPreview();
    }

    function addDeduction() {
        const html = tpl.innerHTML.replaceAll('__INDEX__', String(deductionIndex++));
        const wrap = document.createElement('div');
        wrap.innerHTML = html.trim();
        const row = wrap.firstElementChild;
        const modeSelect = row.querySelector('select');
        const refInput = row.querySelector('.js-deduction-ref');

        function syncPlaceholder() {
            if (modeSelect.value === 'pass_sport') {
                refInput.placeholder = 'Code Pass’Sport';
            } else if (modeSelect.value === 'ancv') {
                refInput.placeholder = 'N° / montant chèques vacances';
            } else {
                refInput.placeholder = 'Référence / note…';
            }
        }

        modeSelect.addEventListener('change', syncPlaceholder);
        syncPlaceholder();

        row.querySelector('.js-remove-deduction').addEventListener('click', function () {
            row.remove();
            updateRecap();
        });
        row.querySelector('.js-deduction-montant').addEventListener('input', updateRecap);
        deductionsContainer.appendChild(row);
        updateRecap();
    }

    document.getElementById('btn-add-deduction').addEventListener('click', addDeduction);
    modeCheque.addEventListener('change', updateModeEcheance);
    modeVirement.addEventListener('change', updateModeEcheance);
    emetteur.addEventListener('input', updateRecap);
    document.querySelectorAll('.js-echeances').forEach(function (el) {
        el.addEventListener('change', function () {
            updateEcheancesPreview();
            updateRecap();
        });
    });

    updateModeEcheance();
})();
</script>
{% endblock %}
