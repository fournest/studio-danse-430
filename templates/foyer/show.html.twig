{% extends 'base.html.twig' %}

{% block title %}Fiche de
	{{ danseur.prenom }}
	{{ danseur.nom }}
{% endblock %}

{% block body %}
	{# 🎨 Le wrapper principal passe en fond noir/sombre continu pour harmoniser le thème #}
	<div class="min-h-[75vh] bg-black text-white py-12 px-4">
		<div
			class="max-w-3xl mx-auto">

			{# Carte principale #}
			<div
				class="bg-gray-900 border border-gray-800 rounded-2xl p-6 md:p-8 shadow-2xl">

				{# 1. En-tête de la fiche #}
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 pb-6 border-b border-gray-800">
					<div>
						<h1 class="text-3xl font-extrabold text-yellow-400">
							{{ danseur.prenom }}
							{{ danseur.nom }}
						</h1>
						<p class="text-gray-400 text-sm mt-1">
							Dossier Familial :
							<span class="text-gray-200 font-medium">{{ danseur.foyer.nom }}</span>
						</p>
					</div>

					{% if isReadOnly is defined and isReadOnly %}
						<span class="px-4 py-2 bg-blue-500/20 text-blue-300 border border-blue-500/40 font-semibold rounded-xl text-xs uppercase tracking-wider">
							👁️ Mode Lecture Seule
						</span>
					{% else %}
						<a href="{{ path('app_foyer_edit', {'id': danseur.id}) }}" class="px-5 py-2.5 bg-yellow-400 text-gray-950 font-bold rounded-xl hover:bg-yellow-300 transition-colors shadow-md text-sm">
							✏️ Modifier la fiche
						</a>
					{% endif %}
				</div>

				{# 2. Grille d'informations : Identité & Cours #}
				<div
					class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

					{# Bloc Identité #}
					<div class="bg-gray-950/60 p-5 rounded-xl border border-gray-800">
						<h2 class="text-xs uppercase tracking-wider text-yellow-500 font-semibold mb-3">
							Informations Personnelles
						</h2>

						<div class="space-y-3 text-sm">
							<div>
								<span class="text-gray-400 block text-xs">Date de naissance</span>
								<span class="font-medium text-gray-100">
									{{ danseur.dateNaissance ? danseur.dateNaissance|date('d/m/Y') : 'Non renseignée' }}
								</span>
							</div>
						</div>
					</div>

					{# Bloc Cours Inscrits #}
					<div class="bg-gray-950/60 p-5 rounded-xl border border-gray-800">
						<h2 class="text-xs uppercase tracking-wider text-yellow-500 font-semibold mb-3">
							Cours de Danse Inscrits
						</h2>

						{% if danseur.inscriptions|length > 0 %}
							<div class="space-y-3">
								{% for inscription in danseur.inscriptions %}
									{% set isSolde = inscription.statutPaiement.value == 'Soldé' %}
									<div class="flex flex-col gap-2 p-3 rounded-lg border border-gray-800 bg-black/30">
										<span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-yellow-500/10 text-yellow-400 border border-yellow-500/30 w-fit">
											💃
											{{ inscription.cours ? inscription.cours.nom : 'Cours' }}
											<span class="text-yellow-600/80 ml-1">({{ inscription.saison }})</span>
										</span>
										<a href="{{ path('app_foyer_inscription_facture', {id: inscription.id}) }}"
										   class="inline-flex items-center justify-center gap-1.5 w-full sm:w-auto px-3 py-2 rounded-lg text-xs font-bold transition-colors {{ isSolde ? 'border border-emerald-600/50 text-emerald-400 hover:bg-emerald-400 hover:text-gray-950' : 'border border-yellow-500/40 text-yellow-400 hover:bg-yellow-400 hover:text-gray-950' }}">
											🧾 {{ isSolde ? 'Télécharger la facture acquittée' : 'Télécharger l\'attestation d\'inscription' }}
										</a>
									</div>
								{% endfor %}
							</div>
						{% elseif danseur.cours|length > 0 %}
							<div class="flex flex-wrap gap-2">
								{% for c in danseur.cours %}
									<span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-yellow-500/10 text-yellow-400 border border-yellow-500/30">
										💃
										{{ c.nom }}
									</span>
								{% endfor %}
							</div>
						{% else %}
							<p class="text-sm text-gray-500 italic">Aucun cours inscrit pour le moment.</p>
						{% endif %}
					</div>
				</div>

				{# 3. Bloc Responsables Légaux & Urgence #}
				<div class="bg-gray-950/60 p-5 rounded-xl border border-gray-800 mb-8">
					<h2 class="text-xs uppercase tracking-wider text-yellow-500 font-semibold mb-4">
						Responsables Légaux & Contacts
					</h2>

					<div
						class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
						{# Parent 1 (Titulaire du compte) #}
						<div>
							<span class="text-gray-400 text-xs block mb-1">Responsable Principal (Foyer)</span>
							<span class="font-medium text-gray-100 block">
								{{ danseur.foyer.user.email }}
							</span>
							<span class="text-xs text-gray-400 block mt-1">
								Urgence / Contact :
								<strong class="text-gray-200">{{ danseur.foyer.contactUrgence|default('Non renseigné') }}</strong>
							</span>
						</div>

						{# Parent 2 (Spécifique ou Foyer) #}
						<div>
							<span class="text-gray-400 text-xs block mb-1">2ᵉ Responsable Légal</span>
							{% if danseur.parent2Prenom %}
								<div class="p-2.5 bg-yellow-500/10 rounded-lg border border-yellow-500/20">
									<span class="font-bold text-yellow-300 block">
										{{ danseur.parent2Prenom }}
										{{ danseur.parent2Nom }}
									</span>
									<span class="inline-block px-2 py-0.5 text-[10px] uppercase font-bold text-yellow-400 bg-yellow-500/20 rounded mt-1">
										Garde alternée / Spécifique
									</span>
									<div class="mt-2 text-xs text-gray-300 space-y-0.5">
										<p>Tél :
											{{ danseur.parent2Telephone|default('-') }}</p>
										<p>Email :
											{{ danseur.parent2Email|default('-') }}</p>
									</div>
								</div>
							{% elseif danseur.foyer.parent2Prenom %}
								<span class="font-medium text-gray-200 block">
									{{ danseur.foyer.parent2Prenom }}
									{{ danseur.foyer.parent2Nom }}
								</span>
								<div class="text-xs text-gray-400 mt-1 space-y-0.5">
									<p>Tél :
										{{ danseur.foyer.parent2Telephone|default('-') }}</p>
									<p>Email :
										{{ danseur.foyer.parent2Email|default('-') }}</p>
								</div>
							{% else %}
								<span class="text-gray-500 italic">Non renseigné</span>
							{% endif %}
						</div>
					</div>
				</div>

				{# 4. Bouton Retour #}
				<div class="pt-4 border-t border-gray-800">
					<a href="{{ path('app_foyer_index') }}" class="inline-flex items-center text-sm text-yellow-400 hover:text-yellow-300 transition-colors font-medium">
						← Retour à mon espace familial
					</a>
				</div>

			</div>
		</div>
	</div>
{% endblock %}
