{% extends 'base.html.twig' %}

{% block title %}Mes coordonnées co-parent - Studio Danse 430{% endblock %}

{% block body %}
<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] flex justify-center items-center">
    <div class="max-w-md w-full space-y-8 bg-neutral-900/60 p-8 rounded-xl border border-neutral-800 backdrop-blur-sm shadow-xl">

        <div class="text-center">
            <h2 class="text-2xl font-extrabold text-[#FFD700] tracking-tight">
                Mes coordonnées
            </h2>
            <p class="mt-2 text-xs text-neutral-400">
                Mettez à jour votre e-mail et téléphone de contact (co-parent). Ces informations sont synchronisées sur les fiches des enfants qui vous sont rattachés.
            </p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="p-3 rounded-md text-sm {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : 'bg-red-950/50 border border-red-800 text-red-400' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'mt-4 space-y-6'}}) }}
            {{ form_row(form.email) }}
            {{ form_row(form.telephone) }}

            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 transition-colors duration-200 uppercase tracking-wider">
                Enregistrer
            </button>
        {{ form_end(form) }}

        <div class="text-center mt-4 border-t border-neutral-800 pt-4">
            <a href="{{ path('app_foyer_index') }}" class="text-sm text-neutral-400 hover:text-white transition-colors">
                ← Retour à mon espace familial
            </a>
        </div>
    </div>
</div>
{% endblock %}
