{% extends 'base.html.twig' %}

{% block title %}Mon Espace Familial - Studio Danse 430
{% endblock %}

{% block body %}
	<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] text-white">
		<div class="max-w-4xl mx-auto space-y-8">

			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="p-4 rounded-md {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : (label == 'warning' ? 'bg-amber-950/50 border border-amber-800 text-amber-300' : 'bg-red-950/50 border border-red-800 text-red-400') }} text-sm mb-4">
						{{ message }}
					</div>
				{% endfor %}
			{% endfor %}

			<div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-neutral-800 pb-6 gap-4">
				<div>
					<h1 class="text-3xl font-extrabold text-[#FFD700] tracking-tight">Mon Espace Familial</h1>
					<p class="text-neutral-400 mt-1">
						{% if isFoyerOwner %}
							Gérez votre foyer et les danseurs de votre famille.
						{% else %}
							Consultation en lecture seule des danseurs qui vous sont rattachés (2ᵉ parent).
						{% endif %}
					</p>
				</div>
				{% if isFoyerOwner %}
					<div>
						<a href="{{ path('app_foyer_add') }}" class="inline-flex items-center px-4 py-2.5 border border-[#FFD700] rounded-md text-sm font-bold text-[#FFD700] hover:bg-[#FFD700] hover:text-black transition-colors uppercase tracking-wider">
							+ Ajouter un danseur
						</a>
					</div>
				{% endif %}
			</div>

			<div class="grid gap-6 md:grid-cols-3">

				<div class="md:col-span-1 bg-neutral-900/60 border border-neutral-800 rounded-xl p-6 h-fit backdrop-blur-sm">
					<h2 class="text-lg font-bold text-neutral-200 mb-4 flex items-center gap-2">
						<span>📋</span>
						Dossier Familial
					</h2>
					<div class="space-y-4 text-sm">
						{% if foyer %}
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Nom du Foyer</span>
								<span class="font-semibold text-neutral-200 text-base">{{ foyer.nom }}</span>
							</div>
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Adresse postale</span>
								<span class="text-neutral-300 block mt-0.5">{{ foyer.adresse }}</span>
								<span class="text-neutral-300 block">{{ foyer.codePostal }}
									{{ foyer.ville }}</span>
							</div>
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Téléphone du compte</span>
								<span class="text-neutral-300 block mt-0.5">{{ app.user.telephone }}</span>
							</div>
							{% if foyer.contactUrgence %}
								<div>
									<span class="text-red-400 block text-xs uppercase font-bold tracking-wider">🚨 En cas d'urgence</span>
									<span class="text-neutral-200 block mt-0.5 font-medium">{{ foyer.contactUrgence }}</span>
								</div>
							{% endif %}
							<div class="mt-12 p-6 border border-red-900/50 rounded-xl bg-red-950/10">
								<h3 class="text-red-500 font-bold mb-4">Zone de danger</h3>

								<form action="{{ path('app_foyer_desactiver') }}" method="POST" class="inline-block mr-4">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ app.user.id) }}">
									<button type="submit" class="text-sm text-neutral-400 hover:text-white">Désactiver mon compte</button>
								</form>

								<form action="{{ path('app_foyer_supprimer') }}" method="POST" class="inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement votre compte ?');">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ app.user.id) }}">
									<button type="submit" class="text-sm text-red-500 hover:text-red-400 font-bold">Supprimer mon compte</button>
								</form>
							</div>
						{% else %}
							<p class="text-neutral-400 text-sm leading-relaxed">
								Vous n’avez pas de foyer titulaire. Les fiches ci-contre sont accessibles en
								<strong class="text-neutral-200">lecture seule</strong>
								via votre e-mail de 2ᵉ parent.
							</p>
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Votre compte</span>
								<span class="text-neutral-300 block mt-0.5">{{ app.user.email }}</span>
								<span class="text-neutral-300 block">{{ app.user.telephone }}</span>
							</div>
						{% endif %}
					</div>
				</div>

				<div class="md:col-span-2 bg-neutral-900/60 border border-neutral-800 rounded-xl p-6 backdrop-blur-sm">
					<h2 class="text-lg font-bold text-neutral-200 mb-4 flex items-center gap-2">
						<span>🩰</span>
						Membres de la famille (Danseurs)
					</h2>

					{% if danseurs is empty %}
						<div class="text-center py-12 border-2 border-dashed border-neutral-800 rounded-lg">
							<p class="text-neutral-500">Aucun danseur n'est enregistré pour le moment dans votre foyer.</p>
							{% if isFoyerOwner %}
								<a href="{{ path('app_foyer_add') }}" class="text-sm text-[#FFD700] hover:underline mt-2 inline-block font-semibold">
									Ajouter votre premier danseur maintenant
								</a>
							{% endif %}
						</div>
					{% else %}
						<div class="space-y-3">
							{% for danseur in danseurs %}
								{% set canEdit = isFoyerOwner and ownedFoyerId and danseur.foyer.id == ownedFoyerId %}
								<div class="flex items-center justify-between p-4 bg-black/40 border border-neutral-800/80 rounded-lg hover:border-neutral-700 transition-colors">
									<div>
										<h3 class="text-xl font-bold">
											<a href="{{ path('app_foyer_show', {'id': danseur.id}) }}" class="text-yellow-400 hover:text-yellow-300 hover:underline transition-colors">
												{{ danseur.prenom }}
												{{ danseur.nom }}
											</a>
										</h3>
										<p class="text-xs text-neutral-400">
											Né(e) le :
											{% if danseur.dateNaissance %}
												{{ danseur.dateNaissance|date('d/m/Y') }}{% else %}Non renseignée
											{% endif %}
										</p>
									</div>
									<div class="flex gap-2 items-center">
										{% if canEdit %}
											<a href="{{ path('app_foyer_edit', {'id': danseur.id}) }}" class="px-3 py-1.5 border border-neutral-800 hover:border-neutral-500 rounded text-xs font-semibold text-neutral-400 hover:text-white transition-colors">
												Modifier
											</a>
										{% else %}
											<span class="px-3 py-1.5 rounded text-xs font-semibold text-neutral-500 border border-neutral-800/60">
												Lecture seule
											</span>
										{% endif %}
									</div>
								</div>
							{% endfor %}
						</div>

						{% if isFoyerOwner %}
							<div class="mt-8 pt-6 border-t border-neutral-800 flex justify-end">
								<a href="{{ path('app_foyer_inscription_cours') }}" class="inline-flex justify-center py-3 px-6 text-sm font-bold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 transition-colors duration-200 uppercase tracking-wider shadow-lg">
									Étape suivante : Choix des cours →
								</a>
							</div>
						{% endif %}
					{% endif %}
				</div>
			</div>

		</div>
	</div>
{% endblock %}
