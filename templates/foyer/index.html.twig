{% extends 'base.html.twig' %}

{% block title %}Mon Foyer - Studio Danse 430{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-950 text-white py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-neutral-900 pb-6 mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight text-amber-500">Mon Foyer Familial</h1>
                <p class="mt-2 text-sm text-neutral-400">Gérez les profils des danseurs et danseuses rattachés à votre compte.</p>
            </div>
            <a href="{{ path('app_foyer_add') }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-semibold bg-amber-500 text-neutral-950 hover:bg-amber-400 transition-colors duration-200">
                + Ajouter un danseur
            </a>
        </div>

        {# Messages Flash pour les succès #}
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 rounded-md bg-emerald-950/50 border border-emerald-500/30 text-emerald-400 text-sm">
                {{ message }}
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 gap-6">
            {% if danseurs is empty %}
                <div class="text-center py-12 bg-neutral-900/50 rounded-lg border border-neutral-900">
                    <p class="text-neutral-400 text-sm">Aucun danseur n'est enregistré pour le moment dans votre foyer.</p>
                </div>
            {% else %}
                {% for danseur in danseurs %}
                    <div class="bg-neutral-900 border border-neutral-800 p-6 rounded-lg flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:border-neutral-700 transition-colors duration-200">
                        <div>
                            <h2 class="text-xl font-bold text-white">{{ danseur.prenom }} {{ danseur.nom }}</h2>
                            <p class="text-sm text-neutral-400 mt-1">
                                📅 Né(e) le : <span class="font-medium text-neutral-200">{{ danseur.dateNaissance|date('d/m/Y') }}</span>
                            </p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                {% if danseur.cours is empty %}
                                    <span class="text-xs bg-neutral-800 text-neutral-500 px-2.5 py-1 rounded-full">Aucun cours inscrit</span>
                                {% else %}
                                    {% for cours in danseur.cours %}
                                        <span class="text-xs bg-amber-500/10 text-amber-400 px-2.5 py-1 rounded-full border border-amber-500/20">{{ cours.nom }}</span>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                        <div class="flex gap-3 w-full sm:w-auto justify-end">
                            <a href="{{ path('app_foyer_edit', {'id': danseur.id}) }}" class="text-sm px-4 py-2 rounded border border-neutral-700 text-neutral-300 hover:bg-neutral-800 hover:text-white transition-all w-full sm:w-auto text-center">
                                Modifier / Inscrire
                            </a>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}