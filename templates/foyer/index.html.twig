{% extends 'base.html.twig' %}

{% block title %}Mon Espace Familial - Studio Danse 430
{% endblock %}

{% block body %}
	<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] text-white">
		<div class="max-w-4xl mx-auto space-y-8">

			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="p-4 rounded-md {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : (label == 'warning' ? 'bg-amber-950/50 border border-amber-800 text-amber-300' : 'bg-red-950/50 border border-red-800 text-red-400') }} text-sm mb-4">
						{{ message }}
					</div>
				{% endfor %}
			{% endfor %}

			{% if isFoyerOwner %}
				{# ===== Stepper inscription ===== #}
				<nav class="inscription-stepper rounded-xl border border-neutral-800 bg-neutral-900/70 p-3 sm:p-4" aria-label="Étapes d’inscription">
					<ol class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3">
						{% set step4_href = premiere_inscription_id
							? (step4_done
								? path('app_foyer_facture_ce')
								: path('app_foyer_inscription_paiement', {id: paiement_inscription_id|default(premiere_inscription_id)}))
							: null %}
						{% set steps = [
							{ n: 1, label: 'Famille', done: step1_done, href: path('app_foyer_add'), enabled: true },
							{ n: 2, label: 'Choix des cours', done: step2_done, href: path('app_foyer_inscription_cours'), enabled: step1_done },
							{ n: 3, label: 'Questionnaires Santé', done: step3_done, href: premiere_inscription_id ? path('app_foyer_inscription_sante', {id: premiere_inscription_id}) : null, enabled: step2_done },
							{ n: 4, label: 'Règlement & Facture', done: step4_done, href: step4_href, enabled: step2_done }
						] %}
						{% for s in steps %}
							{% set is_current = step_courante == s.n and not s.done %}
							<li class="min-w-0">
								{% if s.enabled and s.href %}
									<a href="{{ s.href }}"
									   class="flex items-center gap-2 rounded-lg border px-2.5 py-2 text-left transition-colors
									   {{ s.done ? 'border-emerald-700/60 bg-emerald-950/30 text-emerald-300' : (is_current ? 'border-[#FFD700] bg-[#FFD700]/10 text-[#FFD700]' : 'border-neutral-700 bg-black/30 text-neutral-400 hover:border-neutral-500') }}">
										<span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[11px] font-extrabold
											{{ s.done ? 'bg-emerald-500 text-black' : (is_current ? 'bg-[#FFD700] text-black' : 'bg-neutral-800 text-neutral-400') }}">
											{{ s.done ? '✓' : s.n }}
										</span>
										<span class="min-w-0">
											<span class="block text-[10px] uppercase tracking-wider opacity-70">{{ s.n }}. Étape</span>
											<span class="block text-xs sm:text-sm font-bold truncate">{{ s.label }}</span>
										</span>
									</a>
								{% else %}
									<div class="flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-950/50 px-2.5 py-2 text-neutral-600 cursor-not-allowed opacity-70">
										<span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-neutral-900 text-[11px] font-extrabold text-neutral-600">
											{{ s.n }}
										</span>
										<span class="min-w-0">
											<span class="block text-[10px] uppercase tracking-wider">{{ s.n }}. Étape</span>
											<span class="block text-xs sm:text-sm font-bold truncate">{{ s.label }}</span>
										</span>
									</div>
								{% endif %}
							</li>
						{% endfor %}
					</ol>
				</nav>

				{# ===== Bandeau aide première connexion ===== #}
				<div id="onboarding-banner" class="onboarding-banner rounded-xl border border-[#FFD700]/40 bg-neutral-900/80 p-4 sm:p-5 hidden">
					<div class="flex flex-col sm:flex-row sm:items-start gap-3 sm:gap-4">
						<div class="text-2xl shrink-0" aria-hidden="true">💡</div>
						<div class="flex-1 min-w-0">
							<p class="text-sm sm:text-[15px] text-neutral-200 leading-relaxed">
								<strong class="text-[#FFD700]">Bienvenue sur votre espace !</strong>
								Pour inscrire votre famille :
								1. Ajoutez vos danseurs ➜
								2. Cliquez sur « Choix des cours » ➜
								3. Complétez les certificats ➜
								4. Validez votre paiement.
							</p>
						</div>
						<button type="button"
								id="hide-onboarding-btn"
								class="shrink-0 inline-flex items-center justify-center gap-1.5 self-end sm:self-start px-3 py-1.5 rounded-md border border-neutral-600 text-xs font-semibold text-neutral-300 hover:border-[#FFD700] hover:text-[#FFD700] transition-colors">
							<span aria-hidden="true">✕</span> Masquer l'aide
						</button>
					</div>
				</div>
			{% endif %}

			<div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-neutral-800 pb-6 gap-4">
				<div>
					<h1 class="text-3xl font-extrabold text-[#FFD700] tracking-tight">Mon Espace Familial</h1>
					<p class="text-neutral-400 mt-1">
						{% if isParentPrincipal|default(isFoyerOwner) %}
							Gérez votre foyer et les danseurs de votre famille.
						{% else %}
							Espace co-parent — consultation en lecture seule des enfants qui vous sont rattachés.
						{% endif %}
					</p>
				</div>
				{% if isParentPrincipal|default(isFoyerOwner) %}
					<div>
						<a href="{{ path('app_foyer_add') }}" class="inline-flex items-center px-4 py-2.5 border border-[#FFD700] rounded-md text-sm font-bold text-[#FFD700] hover:bg-[#FFD700] hover:text-black transition-colors uppercase tracking-wider">
							+ Ajouter un danseur
						</a>
					</div>
				{% elseif isCoparent|default(false) %}
					<div>
						<a href="{{ path('app_foyer_coparent_contact') }}" class="inline-flex items-center px-4 py-2.5 border border-[#FFD700] rounded-md text-sm font-bold text-[#FFD700] hover:bg-[#FFD700] hover:text-black transition-colors uppercase tracking-wider">
							✏️ Mes coordonnées
						</a>
					</div>
				{% endif %}
			</div>

			{% if isFoyerOwner and cotisation is defined and cotisation and cotisation.grandTotal > 0 and not reglement_soumis|default(false) %}
				<div class="rounded-xl border border-[#FFD700]/40 bg-[#FFD700]/10 px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
					<div>
						<p class="text-xs font-bold uppercase tracking-wider text-[#FFD700]/80">Total foyer · Saison en cours</p>
						<p class="text-lg sm:text-xl font-extrabold text-[#FFD700] mt-1">
							Grand total à régler :
							{{ cotisation.grandTotal|number_format(2, ',', ' ') }} €
							{% if cotisation.foyerDiscountPercentage > 0 %}
								<span class="text-sm font-semibold text-neutral-300">(Dégressivité cours incluse)</span>
							{% endif %}
						</p>
						{% if cotisation.extrasAmount > 0 %}
							<p class="text-sm text-neutral-400 mt-1">
								Cours {{ cotisation.total|number_format(2, ',', ' ') }} €
								+ boutique/costumes {{ cotisation.extrasAmount|number_format(2, ',', ' ') }} €
							</p>
						{% elseif cotisation.foyerDiscountAmount > 0 %}
							<p class="text-sm text-neutral-400 mt-1">
								Remise foyer −{{ cotisation.foyerDiscountPercentage }} % :
								−{{ cotisation.foyerDiscountAmount|number_format(2, ',', ' ') }} €
							</p>
						{% endif %}
					</div>
					{% if paiement_inscription_id and not step4_done %}
						<a href="{{ path('app_foyer_inscription_paiement', {id: paiement_inscription_id}) }}"
						   class="inline-flex justify-center shrink-0 px-4 py-2.5 rounded-md text-sm font-bold text-black bg-[#FFD700] hover:bg-amber-300 transition-colors">
							Régler maintenant →
						</a>
					{% endif %}
				</div>
			{% elseif isFoyerOwner and cotisation is defined and cotisation and cotisation.grandTotal > 0 and reglement_soumis|default(false) %}
				<div class="rounded-xl border {{ reglement_solde|default(false) ? 'border-emerald-700/50 bg-emerald-950/20' : 'border-sky-700/50 bg-sky-950/20' }} px-5 py-4 space-y-4">
					<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
						<div class="grow">
							<p class="text-xs font-bold uppercase tracking-wider {{ reglement_solde|default(false) ? 'text-emerald-400/80' : 'text-sky-300/80' }}">Total foyer · Saison en cours</p>

							{% if financier_foyer is defined and financier_foyer %}
								<div class="mt-3 grid gap-2 sm:grid-cols-2 text-sm">
									<div>
										<span class="text-neutral-400">Total dû</span>
										<p class="font-bold text-white">{{ financier_foyer.total_du|number_format(2, ',', ' ') }} €</p>
									</div>
									<div>
										<span class="text-neutral-400">Encaissé</span>
										<p class="font-bold text-emerald-300">{{ financier_foyer.total_encaisse|number_format(2, ',', ' ') }} €</p>
									</div>
									<div>
										<span class="text-neutral-400">Déclaré par la famille</span>
										<p class="font-bold text-sky-300">{{ financier_foyer.total_declare|number_format(2, ',', ' ') }} €</p>
									</div>
									<div>
										<span class="text-neutral-400">Reste à payer</span>
										<p class="mt-0.5">
											{% set reste = financier_foyer.reste_a_payer %}
											{% if reste <= 0.001 %}
												<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-sm font-bold bg-emerald-950/60 border border-emerald-700/60 text-emerald-300">
													0,00 € — Soldé
												</span>
											{% elseif reste >= 50 %}
												<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-sm font-bold bg-red-950/50 border border-red-700/50 text-red-200">
													{{ reste|number_format(2, ',', ' ') }} €
												</span>
											{% else %}
												<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-sm font-bold bg-amber-950/50 border border-amber-700/50 text-amber-200">
													{{ reste|number_format(2, ',', ' ') }} €
												</span>
											{% endif %}
										</p>
									</div>
								</div>

								{% if financier_foyer.paiements_declares is not empty %}
									<div class="mt-3 space-y-2">
										{% for paiement in financier_foyer.paiements_declares %}
											<p class="text-xs text-sky-200/90 bg-sky-950/30 border border-sky-800/40 rounded-md px-3 py-2">
												Paiement de {{ paiement.montant|number_format(2, ',', ' ') }} € déclaré le
												{{ paiement.dateDeclaration|date('d/m/Y') }} — En cours de confirmation par la trésorerie
												{% if paiement.reference %} (réf. {{ paiement.reference }}){% endif %}
											</p>
										{% endfor %}
									</div>
								{% endif %}
							{% else %}
								<p class="text-lg sm:text-xl font-extrabold text-white mt-1">
									{{ cotisation.grandTotal|number_format(2, ',', ' ') }} €
								</p>
							{% endif %}

							<p class="mt-2">
								{% if reglement_solde|default(false) %}
									<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-950/60 border border-emerald-700/60 text-emerald-300">
										✅ Soldé
									</span>
								{% else %}
									<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-amber-950/50 border border-amber-700/50 text-amber-200">
										⏳ En attente d'encaissement ou de confirmation
									</span>
								{% endif %}
							</p>
						</div>
						<div class="flex flex-col gap-2 shrink-0">
							{% if declarer_paiement_form and financier_foyer is defined and financier_foyer and financier_foyer.reste_a_payer > 0.001 %}
								<button type="button"
								        id="btn-declarer-paiement"
								        class="inline-flex justify-center px-4 py-2.5 rounded-md text-sm font-bold text-black bg-[#FFD700] hover:bg-amber-300 transition-colors">
									💳 Signaler un règlement effectué
								</button>
							{% endif %}
							<a href="{{ path('app_foyer_facture_ce') }}"
							   class="inline-flex justify-center px-4 py-2.5 rounded-md text-sm font-bold text-black bg-[#FFD700] hover:bg-amber-300 transition-colors">
								📄 Imprimer / Télécharger la Facture &amp; Attestations CE (PDF)
							</a>
						</div>
					</div>
				</div>

				{% if declarer_paiement_form %}
					{% include 'foyer/_declarer_paiement_modal.html.twig' %}
				{% endif %}
			{% endif %}

			<div class="grid gap-6 md:grid-cols-3">

				<div class="md:col-span-1 bg-neutral-900/60 border border-neutral-800 rounded-xl p-6 h-fit backdrop-blur-sm">
					<h2 class="text-lg font-bold text-neutral-200 mb-4 flex items-center gap-2">
						<span>📋</span>
						{% if isParentPrincipal|default(isFoyerOwner) %}
							Dossier Familial
						{% else %}
							Mon profil co-parent
						{% endif %}
					</h2>
					<div class="space-y-4 text-sm">
						{% if isParentPrincipal|default(isFoyerOwner) and foyer %}
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Nom du Foyer</span>
								<span class="font-semibold text-neutral-200 text-base">{{ foyer.nom }}</span>
							</div>
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Adresse postale</span>
								<span class="text-neutral-300 block mt-0.5">{{ foyer.adresse }}</span>
								<span class="text-neutral-300 block">{{ foyer.codePostal }}
									{{ foyer.ville }}</span>
							</div>
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Téléphone du compte</span>
								<span class="text-neutral-300 block mt-0.5">{{ app.user.telephone }}</span>
							</div>
							{% if foyer.contactUrgence %}
								<div>
									<span class="text-red-400 block text-xs uppercase font-bold tracking-wider">🚨 En cas d'urgence</span>
									<span class="text-neutral-200 block mt-0.5 font-medium">{{ foyer.contactUrgence }}</span>
								</div>
							{% endif %}
							<div class="pt-2">
								<a href="{{ path('app_foyer_edit_dossier') }}"
								   class="inline-flex items-center justify-center w-full px-4 py-2.5 border border-[#FFD700] rounded-md text-sm font-bold text-[#FFD700] hover:bg-[#FFD700] hover:text-black transition-colors uppercase tracking-wider">
									✏️ Modifier le dossier
								</a>
							</div>
							<div class="mt-8 p-6 border border-red-900/50 rounded-xl bg-red-950/10">
								<h3 class="text-red-500 font-bold mb-4">Zone de danger</h3>

								<form action="{{ path('app_foyer_desactiver') }}" method="POST" class="inline-block mr-4">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ app.user.id) }}">
									<button type="submit" class="text-sm text-neutral-400 hover:text-white">Désactiver mon compte</button>
								</form>

								<form action="{{ path('app_foyer_supprimer') }}" method="POST" class="inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement votre compte ?');">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ app.user.id) }}">
									<button type="submit" class="text-sm text-red-500 hover:text-red-400 font-bold">Supprimer mon compte</button>
								</form>
							</div>
						{% else %}
							<p class="text-neutral-400 text-sm leading-relaxed">
								Vous êtes connecté en tant que
								<strong class="text-[#FFD700]">co-parent rattaché</strong>.
								La facturation et le règlement restent gérés par le parent titulaire.
							</p>
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Email 2</span>
								<span class="text-neutral-300 block mt-0.5">{{ app.user.email }}</span>
							</div>
							<div>
								<span class="text-neutral-500 block text-xs uppercase font-bold tracking-wider">Téléphone 2</span>
								<span class="text-neutral-300 block mt-0.5">{{ app.user.telephone|default('—') }}</span>
							</div>
							<a href="{{ path('app_foyer_coparent_contact') }}"
							   class="inline-flex items-center justify-center w-full px-4 py-2.5 border border-[#FFD700] rounded-md text-sm font-bold text-[#FFD700] hover:bg-[#FFD700] hover:text-black transition-colors uppercase tracking-wider">
								✏️ Modifier mes coordonnées
							</a>
						{% endif %}
					</div>
				</div>

				<div class="md:col-span-2 bg-neutral-900/60 border border-neutral-800 rounded-xl p-6 backdrop-blur-sm">
					<h2 class="text-lg font-bold text-neutral-200 mb-4 flex items-center gap-2">
						<span>🩰</span>
						{% if isParentPrincipal|default(isFoyerOwner) %}
							Membres de la famille (Danseurs)
						{% else %}
							Enfant(s) rattaché(s)
						{% endif %}
					</h2>

					{% if danseurs is empty %}
						<div class="text-center py-12 border-2 border-dashed border-neutral-800 rounded-lg">
							<p class="text-neutral-500">Aucun danseur n'est enregistré pour le moment dans votre foyer.</p>
							{% if isParentPrincipal|default(isFoyerOwner) %}
								<a href="{{ path('app_foyer_add') }}" class="text-sm text-[#FFD700] hover:underline mt-2 inline-block font-semibold">
									Ajouter votre premier danseur maintenant
								</a>
							{% endif %}
						</div>
					{% else %}
						<div class="space-y-3">
							{% for danseur in danseurs %}
								{% set canEdit = canEditByDanseurId[danseur.id]|default(isFoyerOwner and ownedFoyerId and danseur.foyer.id == ownedFoyerId) %}
								<div class="p-4 bg-black/40 border border-neutral-800/80 rounded-lg hover:border-neutral-700 transition-colors space-y-3">
									<div class="flex items-center justify-between gap-3">
										<div>
											<h3 class="text-xl font-bold">
												<a href="{{ path('app_foyer_show', {'id': danseur.id}) }}" class="text-yellow-400 hover:text-yellow-300 hover:underline transition-colors">
													{{ danseur.prenom }}
													{{ danseur.nom }}
												</a>
											</h3>
											<p class="text-xs text-neutral-400">
												Né(e) le :
												{% if danseur.dateNaissance %}
													{{ danseur.dateNaissance|date('d/m/Y') }}{% else %}Non renseignée
												{% endif %}
											</p>
											{% if canEdit %}
												{% set p2Email = danseur.parent2EmailEffectif %}
												{% if p2Email %}
													{% set compteCree = parent2_compte_cree[danseur.id]|default(false) %}
													{% if compteCree %}
														<p class="mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-950/50 border border-emerald-800/60 text-emerald-300">
															✅ Co-parent rattaché
														</p>
													{% elseif danseur.parent2InvitedAt %}
														<p class="mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-sky-950/40 border border-sky-800/50 text-sky-300">
															📩 Invitation envoyée à {{ p2Email }}
														</p>
													{% else %}
														<p class="mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-neutral-900 border border-neutral-700 text-neutral-400">
															📩 Co-parent : {{ p2Email }}
														</p>
													{% endif %}
												{% endif %}
											{% else %}
												<p class="mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-sky-950/40 border border-sky-800/50 text-sky-300">
													👁️ Lecture seule — co-parent
												</p>
											{% endif %}
										</div>
										<div class="flex gap-2 items-center shrink-0">
											{% if canEdit %}
												<a href="{{ path('app_foyer_edit', {'id': danseur.id}) }}" class="px-3 py-1.5 border border-neutral-800 hover:border-neutral-500 rounded text-xs font-semibold text-neutral-400 hover:text-white transition-colors">
													Modifier
												</a>
											{% else %}
												<span class="px-3 py-1.5 rounded text-xs font-semibold text-neutral-500 border border-neutral-800/60">
													Lecture seule
												</span>
											{% endif %}
										</div>
									</div>

									{% if not canEdit %}
										{% include 'foyer/mon_espace.html.twig' %}
									{% endif %}

									{# Santé (toujours visible, lecture seule pour le coparent) #}
									<div class="flex flex-wrap gap-2 text-xs">
										{% if danseur.hasJustificatifSanteComplet %}
											<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded font-semibold bg-emerald-950/50 border border-emerald-800/60 text-emerald-300">
												✅ Santé : Validé
											</span>
										{% else %}
											<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded font-semibold bg-amber-950/40 border border-amber-800/50 text-amber-200">
												⏳ Santé : En attente
											</span>
										{% endif %}
										<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded font-semibold border border-neutral-700 text-neutral-400">
											{{ danseur.statutSante.label }}
										</span>
									</div>

									{% if danseur.inscriptions|length > 0 %}
										<ul class="space-y-2 border-t border-neutral-800/80 pt-3">
											{% for inscription in danseur.inscriptions %}
												{% set cours = inscription.cours %}
												{% set dossierValide = inscription.statutDossier.value == 'Validé' or inscription.statut.value == 'valide' %}
												<li class="flex flex-col gap-2 text-sm p-3 rounded-lg border border-neutral-800/60 bg-neutral-950/40">
													<div class="min-w-0">
														<span class="text-neutral-200 font-medium">
															{{ cours ? cours.nomComplet : 'Cours' }}
														</span>
														<span class="text-neutral-500 text-xs ml-1">({{ inscription.saison }})</span>
														{% if cours %}
															<p class="text-xs text-neutral-400 mt-1">
																📅 {{ cours.jour }}
																· {{ cours.heure|date('H\\hi') }}
																{% if cours.dureeLabel is defined %}
																	<span class="text-neutral-600">({{ cours.dureeLabel }})</span>
																{% endif %}
																· Prof. {{ cours.professeurPrenom|default(cours.professeurLabel|default(cours.professeur)) }}
															</p>
														{% endif %}
														<div class="mt-2 flex flex-wrap gap-2">
															{% if dossierValide %}
																<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-950/50 border border-emerald-800/60 text-emerald-300">
																	✅ Dossier validé
																</span>
															{% else %}
																<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-amber-950/40 border border-amber-800/50 text-amber-200">
																	⏳ Dossier en attente
																</span>
															{% endif %}
														</div>
														{% if canEdit and (inscription.montantTotal is not null or inscription.planReglement) %}
															{% set isSolde = inscription.statutPaiement.value == 'Soldé' %}
															{% set enAttente = inscription.enAttenteEncaissement %}
															<span class="block text-xs mt-1.5">
																{% if (inscription.montantTotal ?? 0) > 0 %}
																	<span class="text-neutral-500">{{ inscription.montantTotal|number_format(2, ',', ' ') }} €</span>
																	<span class="text-neutral-600">·</span>
																{% endif %}
																{% if isSolde %}
																	<span class="text-emerald-400 font-semibold">{{ inscription.libelleStatutPaiement }}</span>
																{% elseif enAttente %}
																	<span class="inline-flex items-center gap-1 text-amber-300 font-semibold">⏳ {{ inscription.libelleStatutPaiement }}</span>
																{% else %}
																	<span class="text-neutral-400">{{ inscription.libelleStatutPaiement }}</span>
																{% endif %}
															</span>
														{% endif %}
													</div>
													{% if canEdit %}
														<div class="flex flex-wrap gap-2">
															<a href="{{ path('app_foyer_inscription_sante', {id: inscription.id}) }}"
															   class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold transition-colors whitespace-nowrap border border-sky-700/60 text-sky-300 hover:bg-sky-500 hover:text-black">
																Santé / QS-Sport
															</a>
															<a href="{{ path('app_foyer_inscription_facture', {id: inscription.id}) }}"
															   class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold transition-colors whitespace-nowrap border border-[#FFD700]/50 text-[#FFD700] hover:bg-[#FFD700] hover:text-black">
																🧾 Attestation / Facture
															</a>
														</div>
													{% endif %}
												</li>
											{% endfor %}
										</ul>
									{% else %}
										<p class="text-xs text-neutral-500 border-t border-neutral-800/80 pt-3">Aucun cours inscrit pour le moment.</p>
									{% endif %}
								</div>
							{% endfor %}
						</div>

						{% include 'partials/_remarque_pedagogique.html.twig' %}

						{% if isParentPrincipal|default(isFoyerOwner) %}
							<div class="mt-8 pt-6 border-t border-neutral-800 flex flex-col items-stretch sm:items-end gap-3">
								{% if not step2_done %}
									<a href="{{ path('app_foyer_inscription_cours') }}"
									   class="inline-flex justify-center py-3 px-6 text-sm font-bold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 transition-colors duration-200 uppercase tracking-wider shadow-lg">
										Étape suivante : Choix des cours →
									</a>
								{% elseif not step3_done %}
									<a href="{{ path('app_foyer_inscription_sante', {id: premiere_inscription_id}) }}"
									   class="inline-flex justify-center py-3 px-6 text-sm font-bold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 transition-colors duration-200 uppercase tracking-wider shadow-lg">
										Étape suivante : Santé &amp; Certificats →
									</a>
									<a href="{{ path('app_foyer_inscription_cours') }}"
									   class="inline-flex justify-center text-sm font-semibold text-neutral-400 hover:text-[#FFD700] transition-colors">
										✏️ Modifier le choix des cours
									</a>
								{% elseif not step4_done %}
									<a href="{{ path('app_boutique_index') }}"
									   class="inline-flex justify-center py-3 px-6 text-sm font-bold rounded-md border border-neutral-600 text-neutral-300 hover:border-[#FFD700] hover:text-[#FFD700] transition-colors duration-200 uppercase tracking-wider">
										Boutique
									</a>
									<a href="{{ path('app_costumes_index') }}"
									   class="inline-flex justify-center py-3 px-6 text-sm font-bold rounded-md border border-neutral-600 text-neutral-300 hover:border-[#FFD700] hover:text-[#FFD700] transition-colors duration-200 uppercase tracking-wider">
										Location costumes
									</a>
									<a href="{{ path('app_foyer_inscription_paiement', {id: paiement_inscription_id|default(premiere_inscription_id)}) }}"
									   class="inline-flex justify-center py-3 px-6 text-sm font-bold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 transition-colors duration-200 uppercase tracking-wider shadow-lg">
										Étape suivante : Règlement &amp; Paiement →
									</a>
									<a href="{{ path('app_foyer_edit_dossier') }}"
									   class="inline-flex justify-center text-sm font-semibold text-neutral-400 hover:text-[#FFD700] transition-colors">
										✏️ Modifier mon dossier
									</a>
								{% else %}
									<a href="{{ path('app_foyer_facture_ce') }}"
									   class="inline-flex justify-center py-3 px-6 text-sm font-bold rounded-md text-black bg-emerald-400 hover:bg-emerald-300 border border-[#FFD700]/50 transition-colors duration-200 uppercase tracking-wider shadow-lg">
										📄 Imprimer / Télécharger la Facture &amp; Attestations CE (PDF)
									</a>
									<a href="{{ path('app_foyer_inscription_confirmation', {id: premiere_inscription_id}) }}"
									   class="inline-flex justify-center text-sm font-semibold text-neutral-400 hover:text-[#FFD700] transition-colors">
										📋 Voir le détail de mes règlements
									</a>
								{% endif %}
							</div>
						{% endif %}
					{% endif %}
				</div>
			</div>

		</div>
	</div>

	{% if isFoyerOwner %}
	<script>
		(function () {
			const banner = document.getElementById('onboarding-banner');
			const hideBtn = document.getElementById('hide-onboarding-btn');
			if (!banner || !hideBtn) return;

			try {
				if (localStorage.getItem('hide_onboarding') === 'true') {
					banner.style.display = 'none';
				} else {
					banner.classList.remove('hidden');
				}
			} catch (e) {
				banner.classList.remove('hidden');
			}

			hideBtn.addEventListener('click', function () {
				banner.style.display = 'none';
				try {
					localStorage.setItem('hide_onboarding', 'true');
				} catch (e) {}
			});
		})();
	</script>
	{% endif %}
{% endblock %}
