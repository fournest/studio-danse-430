{% extends 'base.html.twig' %}

{% block title %}Boutique — Goodies & Costumes — Studio Danse 430{% endblock %}

{% block body %}
<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] text-white">
    <div class="max-w-5xl mx-auto space-y-8">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="p-4 rounded-md {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : (label == 'warning' ? 'bg-amber-950/50 border border-amber-800 text-amber-300' : 'bg-red-950/50 border border-red-800 text-red-400') }} text-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="border-b border-neutral-800 pb-6">
            <p class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">
                <a href="{{ path('app_foyer_index') }}" class="hover:text-[#FFD700] transition-colors">← Mon foyer</a>
            </p>
            <h1 class="text-3xl font-extrabold text-[#FFD700] tracking-tight">Boutique &amp; locations</h1>
            <p class="text-neutral-400 mt-1">
                Saison {{ saison }} — goodies, vêtements et locations de costumes (optionnel).
            </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-6">
                <form method="post" class="space-y-6" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token('inscription_boutique' ~ inscription.id) }}">

                    <section class="bg-neutral-900/60 border border-neutral-800 rounded-xl p-6 space-y-4">
                        <h2 class="text-sm font-bold uppercase tracking-wider text-[#FFD700]">Articles boutique</h2>
                        {% if goodies is empty %}
                            <p class="text-sm text-neutral-500">Aucun article disponible pour le moment.</p>
                        {% else %}
                            <div class="space-y-4">
                                {% for goodie in goodies %}
                                    {% set achat = achatsByGoodieId[goodie.id]|default(null) %}
                                    <div class="flex flex-col sm:flex-row gap-4 p-4 rounded-lg border border-neutral-800 bg-black/30">
                                        {% if goodie.imageFilename %}
                                            <img src="{{ asset('uploads/goodies/' ~ goodie.imageFilename) }}" alt="{{ goodie.nom }}"
                                                 class="w-full sm:w-24 h-24 object-cover rounded-md border border-neutral-700 shrink-0">
                                        {% else %}
                                            <div class="w-full sm:w-24 h-24 rounded-md bg-neutral-800 flex items-center justify-center text-neutral-600 text-xs shrink-0">Pas d’image</div>
                                        {% endif %}
                                        <div class="flex-1 min-w-0 space-y-2">
                                            <div class="flex flex-wrap items-baseline justify-between gap-2">
                                                <div>
                                                    <p class="font-bold text-white">{{ goodie.nom }}</p>
                                                    <p class="text-xs text-neutral-500 uppercase tracking-wider">{{ goodie.categorie }} · Stock {{ goodie.stock }}</p>
                                                </div>
                                                <p class="text-[#FFD700] font-extrabold">{{ goodie.prixUnitaire|number_format(2, ',', ' ') }} €</p>
                                            </div>
                                            {% if goodie.description %}
                                                <p class="text-sm text-neutral-400">{{ goodie.description }}</p>
                                            {% endif %}
                                            <div class="flex flex-wrap gap-3 items-end">
                                                {% if goodie.taillesDisponibles is not empty %}
                                                    <label class="text-xs text-neutral-500">
                                                        Taille
                                                        <select name="boutique[{{ goodie.id }}][taille]"
                                                                class="mt-1 block rounded-md bg-zinc-900 border border-zinc-700 text-white text-sm px-2 py-1.5">
                                                            <option value="">—</option>
                                                            {% for taille in goodie.taillesDisponibles %}
                                                                <option value="{{ taille }}" {{ achat and achat.taille == taille ? 'selected' : '' }}>{{ taille }}</option>
                                                            {% endfor %}
                                                        </select>
                                                    </label>
                                                {% endif %}
                                                <label class="text-xs text-neutral-500">
                                                    Quantité
                                                    <input type="number" min="0" max="{{ goodie.stock + (achat ? achat.quantite : 0) }}"
                                                           name="boutique[{{ goodie.id }}][quantite]"
                                                           value="{{ achat ? achat.quantite : 0 }}"
                                                           class="mt-1 block w-20 rounded-md bg-zinc-900 border border-zinc-700 text-white text-sm px-2 py-1.5">
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </section>

                    <section class="bg-neutral-900/60 border border-neutral-800 rounded-xl p-6 space-y-4">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                            <h2 class="text-sm font-bold uppercase tracking-wider text-[#FFD700]">Locations de costumes</h2>
                            <a href="{{ path('app_costumes_index') }}"
                               class="text-xs font-bold uppercase tracking-wider text-sky-300 hover:text-[#FFD700] transition-colors">
                                Parcourir le catalogue →
                            </a>
                        </div>
                        {% if reservations is empty %}
                            <p class="text-sm text-neutral-500">
                                Aucune location rattachée à votre foyer. Réservez un costume depuis le catalogue ;
                                il sera ajouté à votre règlement.
                            </p>
                        {% else %}
                            <ul class="space-y-3">
                                {% for reservation in reservations %}
                                    <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 p-3 rounded-lg border border-neutral-800 bg-black/30">
                                        <div>
                                            <p class="font-semibold text-white">{{ reservation.costume.nom }}</p>
                                            <p class="text-xs text-neutral-500">
                                                {{ reservation.quantite }} ×
                                                {% if reservation.taille %}taille {{ reservation.taille }} · {% endif %}
                                                {{ reservation.statut.label }}
                                            </p>
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <span class="text-[#FFD700] font-bold">{{ reservation.prixTotal|number_format(2, ',', ' ') }} €</span>
                                            <button type="submit" name="remove_costume_id" value="{{ reservation.id }}"
                                                    class="text-xs font-semibold text-red-400 hover:text-red-300"
                                                    onclick="return confirm('Retirer cette location du dossier ?');">
                                                Retirer
                                            </button>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </section>

                    <div class="flex flex-col sm:flex-row gap-3 sm:justify-end">
                        <button type="submit" name="_action" value="save"
                                class="inline-flex justify-center px-5 py-2.5 rounded-md border border-neutral-700 text-sm font-semibold text-neutral-300 hover:border-neutral-500 transition-colors">
                            Enregistrer
                        </button>
                        <button type="submit" name="_action" value="continue"
                                class="inline-flex justify-center px-5 py-2.5 rounded-md bg-[#FFD700] text-black text-sm font-bold uppercase tracking-wider hover:bg-amber-300 transition-colors">
                            Continuer vers le règlement →
                        </button>
                    </div>
                </form>
            </div>

            <aside class="lg:col-span-1">
                <div class="sticky top-6 bg-neutral-900/80 border border-[#FFD700]/30 rounded-xl p-5 space-y-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-500">Récapitulatif foyer</h3>
                    <div class="flex justify-between text-sm">
                        <span class="text-neutral-400">Cotisation cours</span>
                        <span class="text-white font-semibold">{{ cotisation.total|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-neutral-400">Boutique</span>
                        <span class="text-white font-semibold">{{ cotisation.goodiesAmount|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-neutral-400">Locations costumes</span>
                        <span class="text-white font-semibold">{{ cotisation.costumesAmount|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <div class="border-t border-neutral-800 pt-3 flex justify-between">
                        <span class="text-[#FFD700] font-bold uppercase tracking-wider text-xs">Grand total</span>
                        <span class="text-[#FFD700] text-xl font-extrabold">{{ cotisation.grandTotal|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <a href="{{ path('app_foyer_inscription_paiement', {id: inscription.id}) }}"
                       class="block text-center text-xs font-semibold text-neutral-500 hover:text-[#FFD700] pt-2">
                        Passer sans article →
                    </a>
                </div>
            </aside>
        </div>
    </div>
</div>
{% endblock %}
