{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Studio Danse 430{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-950 text-white py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto bg-neutral-900 border border-neutral-800 rounded-xl p-8 shadow-2xl">
        
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-amber-500">{{ title }}</h1>
            <p class="text-sm text-neutral-400 mt-1">Remplissez les informations obligatoires de l'élève.</p>
        </div>

        {{ form_start(form) }}
            <div class="space-y-5">
                <div>
                    {{ form_row(form.prenom) }}
                </div>
                <div>
                    {{ form_row(form.nom) }}
                </div>
                <div>
                    {{ form_row(form.dateNaissance) }}
                </div>
                
                {% if form.cours is defined %}
                    <div class="border-t border-neutral-800 pt-4 mt-6">
                        {{ form_label(form.cours) }}
                        {{ form_widget(form.cours) }}
                    </div>
                {% endif %}

                <div class="flex items-center justify-end gap-4 pt-6 border-t border-neutral-800 mt-6">
                    <a href="{{ path('app_foyer_index') }}" class="text-sm font-medium text-neutral-400 hover:text-white transition-colors">
                        Annuler
                    </a>
                    <button type="submit" class="px-5 py-2 rounded-md shadow-sm text-sm font-semibold bg-amber-500 text-neutral-950 hover:bg-amber-400 transition-colors">
                        Enregistrer le profil
                    </button>
                </div>
            </div>
        {{ form_end(form) }}

    </div>
</div>
{% endblock %}