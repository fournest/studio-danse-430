{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Studio Danse 430{% endblock %}

{% block body %}
<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] flex justify-center items-center">
    <div class="max-w-md w-full space-y-8 bg-neutral-900/60 p-8 rounded-xl border border-neutral-800 backdrop-blur-sm shadow-xl">
        
        <div class="text-center">
            <h2 class="text-2xl font-extrabold text-[#FFD700] tracking-tight">
                {{ title }}
            </h2>
            <p class="mt-2 text-xs text-neutral-400">Veuillez remplir tous les champs obligatoires.</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'mt-8 space-y-6'}}) }}
            {{ form_widget(form) }}

            <div>
                <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#FFD700] transition-colors duration-200 uppercase tracking-wider">
                    Enregistrer et continuer
                </button>
            </div>
        {{ form_end(form) }}

        <div class="text-center mt-4 border-t border-neutral-800 pt-4">
            <a href="{{ path('app_foyer_index') }}" class="text-sm text-neutral-400 hover:text-white transition-colors">
                ← Retour à mon espace familial
            </a>
        </div>
    </div>
</div>
{% endblock %}