{% extends 'base.html.twig' %}

{% block title %}Inscription aux cours — Saison {{ saison }} — Studio Danse 430{% endblock %}

{% block body %}
<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] text-white">
    <div class="max-w-5xl mx-auto space-y-8">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="p-4 rounded-md {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : 'bg-red-950/50 border border-red-800 text-red-400' }} text-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="border-b border-neutral-800 pb-6">
            <p class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">
                <a href="{{ path('app_foyer_index') }}" class="hover:text-[#FFD700] transition-colors">← Mon foyer</a>
            </p>
            <h1 class="text-3xl font-extrabold text-[#FFD700] tracking-tight">Inscription aux cours</h1>
            <p class="text-neutral-400 mt-1">
                Saison {{ saison }} — Cochez les créneaux pour chaque danseur. Le récapitulatif tarifaire se met à jour au rechargement.
            </p>
        </div>

        <form method="post" class="grid gap-8 lg:grid-cols-3" id="inscription-cours-form">
            <input type="hidden" name="_token" value="{{ csrf_token('inscription_cours') }}">

            <div class="lg:col-span-2 space-y-6">
                {% for danseur in danseurs %}
                    {% set selectedIds = selectionByDanseur[danseur.id]|default([]) %}
                    {% set packs = coursParDanseur[danseur.id] %}
                    <section class="bg-neutral-900/60 border border-neutral-800 rounded-xl p-6">
                        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
                            <h2 class="text-xl font-bold text-white">
                                {{ danseur.prenom }} {{ danseur.nom }}
                            </h2>
                            <p class="text-xs text-neutral-500">
                                Né(e) en {{ danseur.anneeNaissance ?? '—' }}
                                {% if danseur.anneeNaissance == 2020 %}
                                    <span class="ml-2 text-emerald-400 font-semibold">· Offre 2ᵉ cours gratuit</span>
                                {% endif %}
                            </p>
                        </div>

                        {% if packs.eligible is empty and packs.ineligible is empty %}
                            <p class="text-sm text-neutral-500">Aucun cours n’est ouvert pour le moment.</p>
                        {% else %}
                            <div class="space-y-2">
                                {% for cours in packs.eligible %}
                                    {% set checked = cours.id in selectedIds %}
                                    <label class="flex items-start gap-3 p-3 rounded-lg border cursor-pointer transition-colors {{ checked ? 'border-[#FFD700]/50 bg-[#FFD700]/5' : 'border-neutral-800 bg-black/30 hover:border-neutral-600' }}">
                                        <input
                                            type="checkbox"
                                            name="cours[{{ danseur.id }}][]"
                                            value="{{ cours.id }}"
                                            class="mt-1 accent-[#FFD700] w-4 h-4"
                                            {{ checked ? 'checked' : '' }}
                                        >
                                        <span class="flex-1 min-w-0">
                                            <span class="block text-sm font-semibold text-neutral-100">{{ cours.nom }}</span>
                                            <span class="block text-xs text-neutral-400 mt-0.5">
                                                {{ cours.jour }} · {{ cours.heure|date('H\\hi') }}
                                                · {{ cours.dureeLabel }}
                                                · {{ cours.professeur }}
                                            </span>
                                        </span>
                                        <span class="text-sm font-bold text-[#FFD700] whitespace-nowrap">
                                            {{ cours.tarif|number_format(2, ',', ' ') }} €
                                        </span>
                                    </label>
                                {% else %}
                                    <p class="text-sm text-amber-400/90">Aucun créneau adapté à l’année de naissance de ce danseur.</p>
                                {% endfor %}
                            </div>

                            {% if packs.ineligible is not empty %}
                                <details class="mt-4 group">
                                    <summary class="text-xs text-neutral-500 cursor-pointer hover:text-neutral-300 list-none flex items-center gap-1">
                                        <span class="group-open:rotate-90 transition-transform inline-block">›</span>
                                        {{ packs.ineligible|length }} cours non proposés (tranche d’âge)
                                    </summary>
                                    <ul class="mt-2 space-y-1 pl-3 border-l border-neutral-800">
                                        {% for cours in packs.ineligible %}
                                            <li class="text-xs text-neutral-600 py-1">
                                                {{ cours.nom }}
                                                {% if cours.anneeNaissanceMin or cours.anneeNaissanceMax %}
                                                    — né(e)s
                                                    {% if cours.anneeNaissanceMin and cours.anneeNaissanceMax %}
                                                        {{ cours.anneeNaissanceMin }}–{{ cours.anneeNaissanceMax }}
                                                    {% elseif cours.anneeNaissanceMin %}
                                                        à partir de {{ cours.anneeNaissanceMin }}
                                                    {% else %}
                                                        jusqu’à {{ cours.anneeNaissanceMax }}
                                                    {% endif %}
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </details>
                            {% endif %}
                        {% endif %}
                    </section>
                {% endfor %}
            </div>

            {# Récapitulatif cotisation #}
            <aside class="lg:col-span-1">
                <div class="sticky top-24 bg-neutral-900/80 border border-[#FFD700]/25 rounded-xl p-6 space-y-4 backdrop-blur-sm">
                    <h2 class="text-lg font-bold text-[#FFD700]">Récapitulatif</h2>

                    {% if cotisation.breakdownByDanseur is empty %}
                        <p class="text-sm text-neutral-500">Sélectionnez au moins un cours pour voir le tarif.</p>
                    {% else %}
                        <div class="space-y-4 text-sm">
                            {% for block in cotisation.breakdownByDanseur %}
                                <div>
                                    <p class="font-semibold text-neutral-200 mb-1">{{ block.danseurNom }}</p>
                                    <ul class="space-y-1 text-xs text-neutral-400">
                                        {% for line in block.lines %}
                                            <li class="flex justify-between gap-2">
                                                <span class="truncate {{ line.isGratuit2020 ? 'line-through text-neutral-600' : '' }}">
                                                    {{ line.coursNom }}
                                                    {% if line.isGratuit2020 %}
                                                        <span class="no-underline text-emerald-400 ml-1">(gratuit 2020)</span>
                                                    {% endif %}
                                                </span>
                                                <span class="whitespace-nowrap {{ line.isGratuit2020 ? 'text-emerald-400' : 'text-neutral-300' }}">
                                                    {% if line.isGratuit2020 %}
                                                        0,00 €
                                                    {% else %}
                                                        {{ line.tarifBrut|number_format(2, ',', ' ') }} €
                                                    {% endif %}
                                                </span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="border-t border-neutral-800 pt-4 space-y-2 text-sm">
                            <div class="flex justify-between text-neutral-400">
                                <span>Sous-total brut</span>
                                <span>{{ cotisation.subtotal|number_format(2, ',', ' ') }} €</span>
                            </div>
                            {% if cotisation.gratuit2020Amount > 0 %}
                                <div class="flex justify-between text-emerald-400">
                                    <span>Gratuité enfants 2020</span>
                                    <span>− {{ cotisation.gratuit2020Amount|number_format(2, ',', ' ') }} €</span>
                                </div>
                            {% endif %}
                            {% if cotisation.foyerDiscountPercentage > 0 %}
                                <div class="flex justify-between text-amber-300">
                                    <span>Remise foyer (−{{ cotisation.foyerDiscountPercentage }} %)</span>
                                    <span>− {{ cotisation.foyerDiscountAmount|number_format(2, ',', ' ') }} €</span>
                                </div>
                            {% elseif cotisation.payingCoursesCount == 1 %}
                                <p class="text-xs text-neutral-600">1 cours payant : plein tarif (pas de remise foyer).</p>
                            {% endif %}
                            {% if cotisation.remiseManuelleAmount > 0 %}
                                <div class="flex justify-between text-sky-300">
                                    <span>
                                        Remise bureau
                                        {% if cotisation.motifRemise %}
                                            <span class="block text-xs text-neutral-500 font-normal">{{ cotisation.motifRemise }}</span>
                                        {% endif %}
                                    </span>
                                    <span>− {{ cotisation.remiseManuelleAmount|number_format(2, ',', ' ') }} €</span>
                                </div>
                            {% endif %}
                            <div class="flex justify-between items-baseline pt-2 border-t border-neutral-800">
                                <span class="font-bold text-neutral-200">Total net</span>
                                <span class="text-2xl font-extrabold text-[#FFD700]">
                                    {{ cotisation.total|number_format(2, ',', ' ') }} €
                                </span>
                            </div>
                            <p class="text-xs text-neutral-600">
                                {{ cotisation.payingCoursesCount }} cours payant{{ cotisation.payingCoursesCount > 1 ? 's' : '' }}
                                après éventuelle gratuité 2020.
                            </p>
                        </div>
                    {% endif %}

                    <div class="pt-2 space-y-2">
                        <button
                            type="submit"
                            name="_action"
                            value="preview"
                            class="w-full py-2.5 px-4 text-sm font-semibold rounded-md border border-neutral-700 text-neutral-200 hover:border-[#FFD700]/50 hover:text-[#FFD700] transition-colors"
                        >
                            Recalculer le tarif
                        </button>
                        <button
                            type="submit"
                            name="_action"
                            value="save"
                            class="w-full py-3 px-4 text-sm font-extrabold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 transition-colors uppercase tracking-wider"
                        >
                            Enregistrer les inscriptions
                        </button>
                    </div>
                </div>
            </aside>
        </form>
    </div>
</div>
{% endblock %}
