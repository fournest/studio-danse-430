{% extends 'base.html.twig' %}

{% block title %}Location de Costumes - Studio Danse 430{% endblock %}

{% block body %}
    <!-- Header de la page -->
    <section class="bg-black py-16 border-b border-[#FFD700]/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
            <span class="inline-block px-4 py-1 rounded-full text-xs font-bold bg-[#FFD700] text-black uppercase tracking-wider mb-3">
                Service Externe
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-[#FFD700] mb-4">Location de Costumes</h1>
            <p class="text-lg text-white/80 max-w-2xl mx-auto">
                Découvrez notre catalogue de tenues et de costumes disponibles à la location pour vos spectacles, compagnies ou événements.
            </p>
        </div>
    </section>

    <!-- Grille des Costumes -->
    <section class="bg-black py-16 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            {% if costumes is empty %}
                <div class="text-center py-20 border border-[#FFD700]/30 rounded-3xl bg-neutral-950">
                    <p class="text-xl text-white/70">Le catalogue de location est en cours de mise à jour.</p>
                    <p class="text-white/50 mt-2">Revenez très bientôt pour découvrir nos pièces !</p>
                </div>
            {% else %}
                <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
                    {% for costume in costumes %}
                        <article class="flex flex-col bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden hover:shadow-[0_0_30px_rgba(255,215,0,0.15)] hover:-translate-y-1 transition duration-300 group">
                            
                            <!-- Zone Image & Badge Prix -->
                            <div class="relative aspect-[4/3] bg-neutral-950 overflow-hidden border-b border-neutral-800">
                                {% if costume.photo %}
                                    <img src="{{ asset('uploads/costumes/' ~ costume.photo) }}" 
                                         alt="{{ costume.nom }}" 
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                {% else %}
                                    <!-- Placeholder si pas de photo uploaded -->
                                    <div class="w-full h-full flex flex-col items-center justify-center text-neutral-600 gap-2">
                                        <span class="text-3xl">👗</span>
                                        <span class="text-xs">Aucun visuel disponible</span>
                                    </div>
                                {% endif %}

                                <!-- Badge Prix (Style Macaron Canva) -->
                                {% if costume.prix %}
                                    <span class="absolute top-3 right-3 inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-black bg-[#FFD700] text-black shadow-lg">
                                        {{ costume.prix }}€ / WE
                                    </span>
                                {% endif %}
                            </div>

                            <!-- Corps de la fiche -->
                            <div class="p-5 flex-1 flex flex-col justify-between bg-neutral-900">
                                <div>
                                    <h2 class="text-lg font-bold text-white line-clamp-1 group-hover:text-[#FFD700] transition-colors mb-2">
                                        {{ costume.nom }}
                                    </h2>
                                    
                                    <!-- Caractéristiques -->
                                    <div class="space-y-1.5 text-sm text-neutral-400">
                                        <p class="flex items-center gap-2">
                                            <span class="text-xs text-[#FFD700]">📐</span> 
                                            Taille : <span class="text-white font-medium">{{ costume.taille|default('Non spécifiée') }}</span>
                                        </p>
                                        <p class="flex items-center gap-2">
                                            <span class="text-xs text-[#FFD700]">📦</span> 
                                            En stock : <span class="text-white font-medium">{{ costume.quantite }} exemplaire(s)</span>
                                        </p>
                                    </div>

                                    {% if costume.description %}
                                        <p class="mt-3 text-xs text-neutral-500 line-clamp-2">
                                            {{ costume.description|striptags }}
                                        </p>
                                    {% endif %}
                                </div>

                                <!-- Bouton Action d'information -->
                                <div class="mt-5">
                                    <a href="mailto:contact@studiodanse430.fr?subject=Demande de location : {{ costume.nom|url_encode }}" 
                                       class="block text-center w-full px-4 py-2 bg-transparent border border-[#FFD700] text-[#FFD700] hover:bg-[#FFD700] hover:text-black font-semibold rounded-xl text-xs transition-colors duration-200">
                                        Demander la réservation
                                    </a>
                                </div>
                            </div>

                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}