{% extends 'base.html.twig' %}

{% block title %}Location de Costumes - Studio Danse 430
{% endblock %}

{% block body %}
	<section class="bg-black py-16 border-b border-[#FFD700]/20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
			<span class="inline-block px-4 py-1 rounded-full text-xs font-bold bg-[#FFD700] text-black uppercase tracking-wider mb-3">
				Hors gala
			</span>
			<h1 class="text-4xl sm:text-5xl font-extrabold text-[#FFD700] mb-4">Location de Costumes</h1>
			<p class="text-lg text-white/80 max-w-2xl mx-auto">
				Louez nos costumes pour une soirée ou un week-end : spectacles, compagnies, événements privés.
			</p>
		</div>
	</section>

	<section class="bg-black py-10 min-h-screen">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8">

			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="p-4 rounded-md text-sm {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : (label == 'warning' ? 'bg-amber-950/50 border border-amber-800 text-amber-300' : 'bg-red-950/50 border border-red-800 text-red-400') }}">
						{{ message }}
					</div>
				{% endfor %}
			{% endfor %}

			<form method="get" class="flex flex-col sm:flex-row flex-wrap gap-3 items-stretch sm:items-end bg-neutral-950/60 border border-neutral-800 rounded-2xl p-4">
				<label class="flex-1 min-w-32 text-xs font-semibold text-neutral-400 uppercase tracking-wider">
					Thème
					<select name="theme" class="mt-1.5 w-full rounded-lg bg-zinc-900 border border-zinc-700 text-white text-sm px-3 py-2">
						<option value="">Tous</option>
						{% for t in themes %}
							<option value="{{ t }}" {{ filters.theme == t ? 'selected' : '' }}>{{ t }}</option>
						{% endfor %}
					</select>
				</label>
				<label class="flex-1 min-w-32 text-xs font-semibold text-neutral-400 uppercase tracking-wider">
					Taille
					<select name="taille" class="mt-1.5 w-full rounded-lg bg-zinc-900 border border-zinc-700 text-white text-sm px-3 py-2">
						<option value="">Toutes</option>
						{% for t in tailles %}
							<option value="{{ t }}" {{ filters.taille == t ? 'selected' : '' }}>{{ t }}</option>
						{% endfor %}
					</select>
				</label>
				<label class="flex-1 min-w-32 text-xs font-semibold text-neutral-400 uppercase tracking-wider">
					Genre
					<select name="genre" class="mt-1.5 w-full rounded-lg bg-zinc-900 border border-zinc-700 text-white text-sm px-3 py-2">
						<option value="">Tous</option>
						{% for g in genres %}
							<option value="{{ g }}" {{ filters.genre == g ? 'selected' : '' }}>{{ g }}</option>
						{% endfor %}
					</select>
				</label>
				<div class="flex gap-2">
					<button type="submit" class="px-5 py-2 rounded-lg bg-[#FFD700] text-black text-sm font-bold hover:bg-amber-300 transition-colors">
						Filtrer
					</button>
					{% if filters.theme or filters.taille or filters.genre %}
						<a href="{{ path('app_costumes_index') }}" class="px-4 py-2 rounded-lg border border-neutral-700 text-sm font-semibold text-neutral-300 hover:border-neutral-500 transition-colors">
							Réinitialiser
						</a>
					{% endif %}
				</div>
			</form>

			{% if costumes is empty %}
				<div class="text-center py-20 border border-[#FFD700]/30 rounded-3xl bg-neutral-950">
					<p class="text-xl text-white/70">Aucun costume ne correspond à votre recherche.</p>
					<p class="text-white/50 mt-2">Modifiez les filtres ou revenez bientôt — le catalogue est mis à jour régulièrement.</p>
				</div>
			{% else %}
				<div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
					{% for costume in costumes %}
						{% set tarif = costume.tarifLocationEffectif %}
						<article class="flex flex-col bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden hover:shadow-[0_0_30px_rgba(255,215,0,0.15)] hover:-translate-y-1 transition duration-300 group">
							<div class="relative aspect-4/3 bg-neutral-950 overflow-hidden border-b border-neutral-800">
								{% if costume.photo %}
									<img src="{{ asset('uploads/costumes/' ~ costume.photo) }}" alt="{{ costume.nom }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
								{% else %}
									<div class="w-full h-full flex flex-col items-center justify-center text-neutral-600 gap-2">
										<span class="text-3xl">👗</span>
										<span class="text-xs">Aucun visuel disponible</span>
									</div>
								{% endif %}

								{% if tarif is not null %}
									<span class="absolute top-3 right-3 inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-black bg-[#FFD700] text-black shadow-lg">
										{{ tarif|number_format(2, ',', ' ') }} € / WE
									</span>
								{% endif %}
							</div>

							<div class="p-5 flex-1 flex flex-col justify-between bg-neutral-900">
								<div>
									<h2 class="text-lg font-bold text-white line-clamp-1 group-hover:text-[#FFD700] transition-colors mb-2">
										{{ costume.nom }}
									</h2>

									<div class="space-y-1.5 text-sm text-neutral-400">
										<p class="flex items-center gap-2">
											<span class="text-xs text-[#FFD700]">📐</span>
											Taille :
											<span class="text-white font-medium">{{ costume.taille|default('Non spécifiée') }}</span>
										</p>
										{% if costume.genre %}
											<p class="flex items-center gap-2">
												<span class="text-xs text-[#FFD700]">👤</span>
												<span class="text-white font-medium">{{ costume.genre }}</span>
											</p>
										{% endif %}
										{% if costume.theme %}
											<p class="flex items-center gap-2">
												<span class="text-xs text-[#FFD700]">🎭</span>
												<span class="text-white font-medium">{{ costume.theme }}</span>
											</p>
										{% endif %}
										{% if tarif is not null %}
											<p class="flex items-center gap-2">
												<span class="text-xs text-[#FFD700]">💶</span>
												Location :
												<span class="text-[#FFD700] font-bold">{{ tarif|number_format(2, ',', ' ') }} €</span>
											</p>
										{% endif %}
									</div>

									{% if costume.description %}
										<p class="mt-3 text-xs text-neutral-500 line-clamp-2">
											{{ costume.description|striptags }}
										</p>
									{% endif %}
								</div>

								<div class="mt-5 space-y-2">
									{% if is_granted('ROLE_USER') %}
										<a href="{{ path('app_costumes_reserver', {'id': costume.id}) }}"
										   class="block w-full py-2.5 px-4 bg-amber-400 hover:bg-amber-300 text-black font-bold text-center text-sm rounded-xl transition-colors shadow-md shadow-amber-400/10">
											Réserver pour un événement
										</a>
									{% else %}
										<a href="{{ path('app_login') }}"
										   class="block w-full py-2.5 px-4 bg-amber-400 hover:bg-amber-300 text-black font-bold text-center text-sm rounded-xl transition-colors shadow-md shadow-amber-400/10">
											Connectez-vous pour louer
										</a>
										<a href="mailto:contact@studiodanse430.fr?subject={{ ('Demande location costume : ' ~ costume.nom)|url_encode }}"
										   class="block w-full py-2 px-4 border border-neutral-700 hover:border-[#FFD700] text-neutral-300 hover:text-[#FFD700] font-semibold text-center text-xs rounded-xl transition-colors">
											Demande rapide par e-mail
										</a>
									{% endif %}
								</div>
							</div>
						</article>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</section>
{% endblock %}
