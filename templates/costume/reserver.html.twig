{% extends 'base.html.twig' %}

{% block title %}Réserver
	{{ costume.nom }}
	| Studio Danse 430
{% endblock %}

{% block body %}
	{# Style spécifique pour passer les icônes de calendrier natives en couleur Or #}
	<style>
		input[type="date"]::-webkit-calendar-picker-indicator {
			filter: invert(80%) sepia(100%) saturate(1000%) hue-rotate(350deg);
			cursor: pointer;
		}
	</style>

	<div class="min-h-screen bg-zinc-950 text-zinc-100 py-12 px-4 sm:px-6 lg:px-8">
		<div
			class="max-w-5xl mx-auto space-y-8">

			{# Bouton Retour #}
			<div>
				<a href="{{ path('app_costume_index') }}" class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-amber-400 transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
					</svg>
					Retour au catalogue des costumes
				</a>
			</div>

			{# Titre de la page #}
			<div class="border-b border-zinc-800 pb-5">
				<h1 class="text-3xl font-extrabold text-white tracking-tight">
					Demande de réservation de
					<span class="text-amber-400">costume</span>
				</h1>
				<p class="mt-2 text-sm text-zinc-400">
					Remplissez le formulaire ci-dessous pour effectuer votre demande de location auprès du studio.
				</p>
			</div>

			<div
				class="grid grid-cols-1 lg:grid-cols-12 gap-8">

				{# Colonne Gauche : Récapitulatif du costume & de l'adhérent #}
				<div
					class="lg:col-span-5 space-y-6">

					{# Fiche du costume #}
					<div class="bg-zinc-900/80 rounded-2xl border border-zinc-800 overflow-hidden shadow-xl">
						{% if costume.photo %}
							<img src="{{ asset('uploads/costumes/' ~ costume.photo) }}" alt="{{ costume.nom }}" class="w-full h-64 object-cover">
						{% else %}
							<div class="w-full h-64 bg-zinc-800 flex items-center justify-center text-zinc-500">
								<span>Pas de visuel disponible</span>
							</div>
						{% endif %}

						<div class="p-6 space-y-4">
							<h2 class="text-xl font-bold text-white">{{ costume.nom }}</h2>

							{% if costume.description %}
								<p class="text-xs text-zinc-400 leading-relaxed">{{ costume.description }}</p>
							{% endif %}

							<div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between text-sm">
								<span class="text-zinc-400">Tarif location / week-end</span>
								<span class="text-lg font-bold text-amber-400">{{ costume.prix|number_format(2, ',', ' ') }}
									€</span>
							</div>
						</div>
					</div>

					{# Rappel du demandeur (Compte connecté) #}
					<div class="bg-zinc-900/50 rounded-xl border border-zinc-800/80 p-5 space-y-2 text-xs">
						<div class="flex items-center gap-2 text-amber-400 font-semibold uppercase tracking-wider">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
							Informations du demandeur
						</div>
						<p class="text-zinc-200 font-medium text-sm">{{ app.user.foyer ? app.user.foyer.nom : app.user.email }}</p>
						<p class="text-zinc-400">E-mail :
							<span class="text-zinc-300">{{ app.user.email }}</span>
						</p>
						{% if app.user.telephone %}
							<p class="text-zinc-400">Téléphone :
								<span class="text-zinc-300">{{ app.user.telephone }}</span>
							</p>
						{% endif %}
						<p class="text-[11px] text-zinc-500 italic pt-2 border-t border-zinc-800/60">
							Ces coordonnées seront utilisées par l'association pour valider votre demande.
						</p>
					</div>

				</div>

				{# Colonne Droite : Formulaire #}
				<div class="lg:col-span-7">
					<div class="bg-zinc-900/80 rounded-2xl border border-zinc-800 p-6 sm:p-8 shadow-xl">

						{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

						{# Taille & Quantité #}
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								{{ form_label(form.taille, null, {'label_attr': {'class': 'block text-xs font-medium text-zinc-300 mb-1'}}) }}
								{{ form_widget(form.taille) }}
								{{ form_errors(form.taille, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
							</div>
							<div>
								{{ form_label(form.quantite, null, {'label_attr': {'class': 'block text-xs font-medium text-zinc-300 mb-1'}}) }}
								{{ form_widget(form.quantite) }}
								{{ form_errors(form.quantite, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
							</div>
						</div>

						{# Date de l'événement #}
						<div>
							{{ form_label(form.dateEvenement, null, {'label_attr': {'class': 'block text-xs font-medium text-zinc-300 mb-1'}}) }}
							{{ form_widget(form.dateEvenement) }}
							{{ form_errors(form.dateEvenement, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
						</div>

						{# Période de location (Début / Fin) #}
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								{{ form_label(form.dateDebut, null, {'label_attr': {'class': 'block text-xs font-medium text-zinc-300 mb-1'}}) }}
								{{ form_widget(form.dateDebut) }}
								{{ form_errors(form.dateDebut, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
							</div>
							<div>
								{{ form_label(form.dateFin, null, {'label_attr': {'class': 'block text-xs font-medium text-zinc-300 mb-1'}}) }}
								{{ form_widget(form.dateFin) }}
								{{ form_errors(form.dateFin, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
							</div>
						</div>

						{# Mode de livraison (Rendu personnalisé des radios) #}
						<div>
							{{ form_label(form.modeLivraison, null, {'label_attr': {'class': 'block text-xs font-medium text-zinc-300 mb-2'}}) }}
							<div class="p-4 rounded-xl bg-zinc-950/80 border border-zinc-800 space-y-3">
								{% for child in form.modeLivraison %}
									<label class="flex items-center gap-3 text-sm text-zinc-200 cursor-pointer hover:text-amber-400 transition-colors">
										{{ form_widget(child, {'attr': {'class': 'w-4 h-4 text-amber-400 bg-zinc-900 border-zinc-700 focus:ring-amber-400 focus:ring-offset-zinc-950'}}
										) }}
										<span>{{ child.vars.label }}</span>
									</label>
								{% endfor %}
							</div>
							{{ form_errors(form.modeLivraison, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
						</div>

						{# Remarques #}
						<div>
							{{ form_label(form.remarques, null, {'label_attr': {'class': 'block text-xs font-medium text-zinc-300 mb-1'}}) }}
							{{ form_widget(form.remarques) }}
							{{ form_errors(form.remarques, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
						</div>

						{# Bouton de soumission #}
						<div class="pt-4">
							<button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold shadow-lg shadow-amber-400/10 transition-all text-center">
								Valider la demande de réservation
							</button>
						</div>

						{{ form_end(form) }}

					</div>
				</div>

			</div>
		</div>
	</div>
{% endblock %}
