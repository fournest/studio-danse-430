{% extends 'base.html.twig' %}

{% block title %}Confirmation du montant — {{ costume.nom }} | Studio Danse 430{% endblock %}

{% block body %}
<div class="min-h-screen bg-zinc-950 text-zinc-100 py-12 px-4 sm:px-6 lg:px-8">
	<div class="max-w-2xl mx-auto space-y-8">
		<a href="{{ path('app_costumes_reserver', {id: costume.id}) }}" class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-amber-400 transition-colors">
			← Modifier la demande
		</a>

		<div class="border-b border-zinc-800 pb-5">
			<p class="text-xs font-bold uppercase tracking-wider text-amber-400/80 mb-2">Étape 2 / 3</p>
			<h1 class="text-3xl font-extrabold text-white tracking-tight">Confirmer le montant</h1>
			<p class="mt-2 text-sm text-zinc-400">Vérifiez le tarif de location et la caution avant validation.</p>
		</div>

		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="p-4 rounded-md text-sm {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : 'bg-red-950/50 border border-red-800 text-red-400' }}">
					{{ message }}
				</div>
			{% endfor %}
		{% endfor %}

		<article class="bg-zinc-900/80 rounded-2xl border border-zinc-800 p-6 space-y-4">
			<div class="flex items-start justify-between gap-4">
				<div>
					<h2 class="text-xl font-bold text-white">{{ costume.nom }}</h2>
					<p class="text-sm text-zinc-400 mt-1">
						Taille {{ draft.taille|default('—') }}
						· Qté {{ draft.quantite }}
						· du {{ draft.dateDebut|date('d/m/Y') }} au {{ draft.dateFin|date('d/m/Y') }}
					</p>
				</div>
				<p class="text-2xl font-extrabold text-amber-400 whitespace-nowrap">{{ prixTotal|number_format(2, ',', ' ') }} €</p>
			</div>

			<div class="rounded-xl border border-amber-400/30 bg-amber-400/5 p-4 text-sm text-zinc-300 leading-relaxed">
				<strong class="text-amber-400">Caution :</strong>
				une caution de <strong class="text-white">{{ caution|number_format(2, ',', ' ') }} €</strong>
				sera à déposer au retrait du costume (chèque ou espèces). Elle vous sera restituée à la remise en bon état.
			</div>
		</article>

		<form method="post" class="bg-zinc-900/80 rounded-2xl border border-zinc-800 p-6 space-y-5" data-turbo="false">
			<input type="hidden" name="_token" value="{{ csrf_token('costume_validation' ~ costume.id) }}">

			<fieldset>
				<legend class="text-sm font-bold text-white mb-3">Mode de règlement (1×)</legend>
				<div class="space-y-2">
					{% for mode in modesPaiement %}
						<label class="flex items-center gap-3 p-3 rounded-xl border border-zinc-800 bg-zinc-950/60 cursor-pointer hover:border-amber-400/50 transition-colors">
							<input type="radio" name="modePaiement" value="{{ mode.value }}" class="accent-amber-400"
								{{ loop.first ? 'checked' : '' }} required>
							<span class="text-sm text-zinc-200">{{ mode.label }}</span>
						</label>
					{% endfor %}
				</div>
			</fieldset>

			<p class="text-xs text-zinc-500">
				La demande sera enregistrée en attente de validation par le bureau. Le paiement en ligne (HelloAsso) pourra être finalisé ensuite si besoin.
			</p>

			<button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold transition-all">
				Valider la demande de location
			</button>
		</form>
	</div>
</div>
{% endblock %}
