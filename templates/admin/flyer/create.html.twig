{% extends '@EasyAdmin/page/content.html.twig' %}

{% form_theme form 'admin/flyer/form_theme.html.twig' %}

{% block content_title %}Flyers &amp; Événements{% endblock %}

{% block main %}
<style>
    .flyer-admin {
        max-width: 980px;
        color: #f3f3f3;
    }
    .flyer-admin__intro {
        margin: 0 0 1.75rem;
        padding: 1.25rem 1.5rem;
        background: #161616;
        border-left: 3px solid #FFD700;
        border-radius: 0 0.75rem 0.75rem 0;
    }
    .flyer-admin__intro h2 {
        margin: 0 0 0.5rem;
        color: #FFD700;
        font-size: 1.15rem;
        font-weight: 700;
    }
    .flyer-admin__intro p {
        margin: 0 0 0.65rem;
        color: rgba(255, 255, 255, 0.65);
        font-size: 0.95rem;
        line-height: 1.55;
    }
    .flyer-admin__intro ul {
        margin: 0.5rem 0 0;
        padding-left: 1.25rem;
        color: rgba(255, 255, 255, 0.55);
        font-size: 0.88rem;
        line-height: 1.5;
    }
    .flyer-admin__grid {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 1.75rem;
        align-items: start;
    }
    @media (max-width: 900px) {
        .flyer-admin__grid { grid-template-columns: 1fr; }
    }
    .flyer-admin__panel {
        background: #141414;
        border: 1px solid rgba(255, 215, 0, 0.22);
        border-radius: 1rem;
        padding: 1.75rem 1.75rem 1.5rem;
    }
    .flyer-admin__panel-title {
        margin: 0 0 1.35rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        color: #FFD700;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .flyer-admin__subsection {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .flyer-admin__subsection-title {
        margin: 0 0 1rem;
        color: rgba(255, 215, 0, 0.9);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
    .flyer-admin .form-group,
    .flyer-admin .mb-3 {
        margin-bottom: 1.35rem !important;
    }
    .flyer-admin label,
    .flyer-admin .form-control-label,
    .flyer-admin .col-form-label {
        display: block !important;
        float: none !important;
        width: 100% !important;
        max-width: none !important;
        margin: 0 0 0.45rem !important;
        padding: 0 !important;
        color: rgba(255, 215, 0, 0.95) !important;
        font-size: 0.92rem !important;
        font-weight: 650 !important;
        text-align: left !important;
    }
    .flyer-admin .form-widget,
    .flyer-admin .form-widget-col,
    .flyer-admin .col-md-*,
    .flyer-admin [class*="col-"] {
        width: 100% !important;
        max-width: none !important;
        flex: none !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
    .flyer-admin .form-row,
    .flyer-admin .row {
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    .flyer-admin .form-control,
    .flyer-admin .form-select,
    .flyer-admin textarea,
    .flyer-admin input[type="text"],
    .flyer-admin input[type="url"] {
        width: 100% !important;
        min-height: 2.75rem;
        padding: 0.7rem 0.95rem !important;
        background: #0c0c0c !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        color: #fff !important;
        border-radius: 0.65rem !important;
        font-size: 0.98rem !important;
        line-height: 1.4 !important;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .flyer-admin textarea {
        min-height: 7.5rem;
        resize: vertical;
    }
    .flyer-admin .form-control:focus,
    .flyer-admin textarea:focus,
    .flyer-admin input:focus {
        border-color: #FFD700 !important;
        box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.15) !important;
        outline: none !important;
    }
    .flyer-admin .form-help,
    .flyer-admin .form-text,
    .flyer-admin .help-text {
        display: block;
        margin-top: 0.45rem !important;
        color: rgba(255, 255, 255, 0.45) !important;
        font-size: 0.82rem !important;
        line-height: 1.4 !important;
    }
    .flyer-admin .form-check {
        margin: 0 0 0.85rem !important;
        padding: 0.95rem 1.05rem 0.95rem 2.6rem !important;
        background: #0c0c0c;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        min-height: auto;
    }
    .flyer-admin .form-check:last-child {
        margin-bottom: 0 !important;
    }
    .flyer-admin .form-check:has(input:checked) {
        border-color: rgba(255, 215, 0, 0.55);
        background: rgba(255, 215, 0, 0.06);
    }
    .flyer-admin .form-check-input {
        margin-top: 0.2rem;
        width: 1.05rem;
        height: 1.05rem;
    }
    .flyer-admin .form-check-input:checked {
        background-color: #FFD700;
        border-color: #FFD700;
    }
    .flyer-admin .form-check-label {
        color: #f0f0f0 !important;
        font-size: 0.95rem !important;
        font-weight: 500 !important;
        line-height: 1.4 !important;
        cursor: pointer;
    }
    .flyer-admin__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 1.75rem;
        padding-top: 1.35rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .flyer-admin__actions .btn {
        min-height: 2.85rem;
        padding: 0.7rem 1.35rem !important;
        border-radius: 999px !important;
        font-weight: 700 !important;
        font-size: 0.95rem !important;
    }
    .flyer-admin__actions .btn-primary,
    .flyer-admin__actions button[type="submit"] {
        background: #FFD700 !important;
        border-color: #FFD700 !important;
        color: #111 !important;
    }
    .flyer-admin__actions .btn-primary:hover,
    .flyer-admin__actions button[type="submit"]:hover {
        background: #e6c200 !important;
        border-color: #e6c200 !important;
        color: #111 !important;
    }
    .flyer-admin__actions .btn-secondary {
        background: transparent !important;
        border: 1px solid rgba(255, 215, 0, 0.45) !important;
        color: #FFD700 !important;
    }
    .flyer-admin__required-legend {
        margin: 0 0 1.25rem;
        padding: 0.65rem 1rem;
        background: rgba(255, 215, 0, 0.08);
        border: 1px solid rgba(255, 215, 0, 0.25);
        border-radius: 0.65rem;
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.88rem;
    }
    .flyer-admin__required-legend .required-marker,
    .flyer-admin .flyer-field-required::after {
        content: ' *';
        color: #FFD700;
        font-weight: 800;
    }
    .flyer-admin .flyer-field-conditional-required.flyer-field-required-visible::after {
        content: ' *';
        color: #FFD700;
        font-weight: 800;
    }
    .flyer-admin__errors {
        margin: 0 0 1.25rem;
        padding: 1rem 1.15rem;
        background: rgba(220, 53, 69, 0.12);
        border: 1px solid rgba(220, 53, 69, 0.55);
        border-left: 4px solid #dc3545;
        border-radius: 0.65rem;
        color: #ffb4b4;
    }
    .flyer-admin__errors-title {
        margin: 0 0 0.5rem;
        color: #ff6b6b;
        font-weight: 700;
        font-size: 0.95rem;
    }
    .flyer-admin__errors ul {
        margin: 0;
        padding-left: 1.2rem;
        font-size: 0.9rem;
        line-height: 1.5;
    }
    .flyer-admin .flyer-field-errors {
        margin: 0.4rem 0 0;
        padding: 0;
        list-style: none;
        color: #ff6b6b;
        font-size: 0.85rem;
        font-weight: 600;
    }
    .flyer-admin .form-control.is-invalid,
    .flyer-admin textarea.is-invalid,
    .flyer-admin .is-invalid-group {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 2px rgba(220, 53, 69, 0.2) !important;
    }
</style>

    <div class="flyer-admin">
        <div class="flyer-admin__intro">
            <h2><i class="fa fa-calendar-days"></i> Générateur Flyers &amp; Événements</h2>
            <p>
                Cet outil sert <strong style="color:#FFD700;">exclusivement</strong> à composer et imprimer
                les supports de communication du club : Assemblée Générale, Gala, ventes (chocolats, saucissons),
                stages, inscriptions, etc.
            </p>
            <ul>
                <li>Étape 1 : renseignez le contenu et les options du flyer.</li>
                <li>Étape 2 : choisissez si l’événement apparaît dans le fil d’actualités du site.</li>
                <li>Étape 3 : cliquez sur <strong style="color:#FFD700;">Générer &amp; Imprimer</strong> — le flyer s’ouvre en PDF/impression et l’événement est enregistré.</li>
            </ul>
            <p class="flyer-admin__required-legend">
                <span class="required-marker" aria-hidden="true">*</span>
                Champs obligatoires : <strong>Titre</strong>, <strong>Badge / Saison</strong>,
                <strong>Mode d'affichage</strong>, <strong>Destination QR Code</strong>
                (+ <strong>URL personnalisée</strong> si cette option est choisie).
            </p>
        </div>

        {% if not form.vars.valid %}
            <div class="flyer-admin__errors" role="alert">
                <p class="flyer-admin__errors-title">
                    <i class="fa fa-triangle-exclamation"></i> Corrigez les champs signalés ci-dessous
                </p>
                <ul>
                    {% for error in form.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                    {% for child in form.children %}
                        {% for error in child.vars.errors %}
                            <li><strong>{{ child.vars.label|default(child.name) }}</strong> — {{ error.message }}</li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {{ form_start(form, {
            attr: {
                id: 'flyer-config-form',
                class: 'ea-form',
                method: 'post',
                novalidate: 'novalidate'
            }
        }) }}
            {{ form_widget(form._token) }}

            <div class="flyer-admin__grid">
                <section class="flyer-admin__panel">
                    <h3 class="flyer-admin__panel-title">Contenu du flyer</h3>
                    {{ form_row(form.titre) }}
                    {{ form_row(form.sous_titre) }}
                    {{ form_row(form.badge) }}
                    {{ form_row(form.description) }}
                    {{ form_row(form.tags) }}
                </section>

                <section class="flyer-admin__panel">
                    <h3 class="flyer-admin__panel-title">Options</h3>
                    {{ form_row(form.mode) }}
                    {{ form_row(form.target) }}
                    <div id="flyer-custom-url" hidden>
                        {{ form_row(form.target_url) }}
                    </div>

                    <div class="flyer-admin__subsection">
                        <h4 class="flyer-admin__subsection-title">Fil d'actualités / Site Web</h4>
                        {{ form_row(form.publier_dans_fil) }}
                    </div>
                </section>
            </div>

            <div class="flyer-admin__actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-print"></i> Générer &amp; Imprimer
                </button>
                <a href="{{ path('admin') }}" class="btn btn-secondary">Annuler</a>
            </div>

        {{ form_end(form) }}
    </div>

    <script>
        (function () {
            const form = document.getElementById('flyer-config-form');
            if (!form) return;

            const customWrap = document.getElementById('flyer-custom-url');
            const urlInscription = {{ url_inscription|json_encode|raw }};
            const urlHome = {{ url_home|json_encode|raw }};

            function selectedValue(name) {
                const checked = form.querySelector('input[name="' + name + '"]:checked');
                if (checked) return checked.value;
                const select = form.querySelector('[name="' + name + '"]');
                return select ? select.value : null;
            }

            function syncCustomUrl() {
                const target = selectedValue('target');
                const urlLabel = customWrap ? customWrap.querySelector('.flyer-field-conditional-required') : null;
                const urlInput = form.querySelector('[name="target_url"]');

                if (customWrap) {
                    customWrap.hidden = target !== 'custom';
                }

                if (urlLabel) {
                    urlLabel.classList.toggle('flyer-field-required-visible', target === 'custom');
                }
                if (urlInput) {
                    urlInput.required = target === 'custom';
                    urlInput.setAttribute('aria-required', target === 'custom' ? 'true' : 'false');
                }
            }

            form.addEventListener('change', syncCustomUrl);
            syncCustomUrl();

            form.addEventListener('submit', function () {
                const target = selectedValue('target');
                const urlField = form.querySelector('[name="target_url"]');
                if (!urlField) return;

                if (target === 'inscription') {
                    urlField.value = urlInscription;
                } else if (target === 'home') {
                    urlField.value = urlHome;
                }
            });
        })();
    </script>
{% endblock %}
