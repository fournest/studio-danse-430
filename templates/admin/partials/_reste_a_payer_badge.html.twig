{% if reste <= 0.001 %}
    <span class="badge bg-success">{{ reste|number_format(2, ',', ' ') }} €</span>
{% elseif reste >= 50 %}
    <span class="badge bg-danger">{{ reste|number_format(2, ',', ' ') }} €</span>
{% else %}
    <span class="badge bg-warning text-dark">{{ reste|number_format(2, ',', ' ') }} €</span>
{% endif %}
