{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Tableau de bord{% endblock %}

{% block main %}
    {# Chargement sécurisé de Tailwind v3 sans écraser le CSS natif d'EasyAdmin #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        corePlugins: {
          preflight: false,
        }
      }
    </script>

    <div class="space-y-8 font-sans text-white p-2">

        {% if is_granted('ROLE_BUREAU') %}
            <div class="flex flex-wrap gap-3">
                <a href="{{ path('app_scan_station') }}"
                   class="inline-flex items-center gap-2 rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-2.5 text-sm font-semibold text-emerald-300 no-underline transition-colors hover:border-emerald-400 hover:bg-emerald-500/20 hover:text-emerald-200">
                    <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
                    Ouvrir la station scan
                </a>
            </div>
        {% endif %}
        
        {# ========================================== #}
        {# GRILLE DES CARTES KPI (Statistiques)       #}
        {# ========================================== #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            
            {# Carte: Danseurs #}
            <div class="bg-[#111111] border border-[#FFD700]/30 rounded-xl p-6 shadow-lg flex items-center transition-all duration-200 hover:-translate-y-1 hover:border-[#FFD700]">
                <div class="bg-[#FFD700]/10 text-[#FFD700] w-14 h-14 rounded-full flex items-center justify-center text-2xl mr-5 shrink-0">
                    <i class="fa-solid fa-person-walking"></i>
                </div>
                <div>
                    <h3 class="m-0 text-sm uppercase tracking-wider text-white/70 font-semibold">Total Danseurs</h3>
                    <p class="m-0 mt-1 text-3xl font-extrabold text-[#FFD700] leading-none">{{ total_danseurs }}</p>
                </div>
            </div>

            {# Carte: Cours #}
            <div class="bg-[#111111] border border-[#FFD700]/30 rounded-xl p-6 shadow-lg flex items-center transition-all duration-200 hover:-translate-y-1 hover:border-[#FFD700]">
                <div class="bg-[#FFD700]/10 text-[#FFD700] w-14 h-14 rounded-full flex items-center justify-center text-2xl mr-5 shrink-0">
                    <i class="fa-solid fa-music"></i>
                </div>
                <div>
                    <h3 class="m-0 text-sm uppercase tracking-wider text-white/70 font-semibold">Total Cours</h3>
                    <p class="m-0 mt-1 text-3xl font-extrabold text-[#FFD700] leading-none">{{ total_cours }}</p>
                </div>
            </div>

            {# Carte: Inscriptions #}
            <div class="bg-[#111111] border border-[#FFD700]/30 rounded-xl p-6 shadow-lg flex items-center transition-all duration-200 hover:-translate-y-1 hover:border-[#FFD700]">
                <div class="bg-[#FFD700]/10 text-[#FFD700] w-14 h-14 rounded-full flex items-center justify-center text-2xl mr-5 shrink-0">
                    <i class="fa-solid fa-file-signature"></i>
                </div>
                <div>
                    <h3 class="m-0 text-sm uppercase tracking-wider text-white/70 font-semibold">Inscriptions</h3>
                    <p class="m-0 mt-1 text-3xl font-extrabold text-[#FFD700] leading-none">{{ total_inscriptions }}</p>
                </div>
            </div>

            {# Carte: Dossiers en attente #}
            <div class="bg-[#111111] border rounded-xl p-6 shadow-lg flex items-center transition-all duration-200 hover:-translate-y-1 {% if dossiers_en_attente > 0 %}border-amber-500 shadow-[0_0_15px_rgba(245,158,11,0.2)]{% else %}border-[#FFD700]/30 hover:border-[#FFD700]{% endif %}">
                <div class="w-14 h-14 rounded-full flex items-center justify-center text-2xl mr-5 shrink-0 {% if dossiers_en_attente > 0 %}bg-amber-500/10 text-amber-500{% else %}bg-[#FFD700]/10 text-[#FFD700]{% endif %}">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <h3 class="m-0 text-sm uppercase tracking-wider text-white/70 font-semibold">Dossiers en attente</h3>
                    <p class="m-0 mt-1 text-3xl font-extrabold leading-none {% if dossiers_en_attente > 0 %}text-amber-500{% else %}text-[#FFD700]{% endif %}">{{ dossiers_en_attente }}</p>
                </div>
            </div>
        </div>

        {# ========================================== #}
        {# TABLEAU DE L'ACTIVITÉ RÉCENTE             #}
        {# ========================================== #}
        <div class="bg-[#111111] border border-[#FFD700]/30 rounded-xl overflow-hidden shadow-lg">
            <div class="p-5 border-b border-[#FFD700]/15 flex items-center gap-3">
                <i class="fa-solid fa-bolt text-[#FFD700] text-xl"></i>
                <h2 class="m-0 text-xl text-[#FFD700] font-bold">Activité récente : Dernières inscriptions</h2>
            </div>
            
            {% if dernieres_inscriptions is empty %}
                <div class="p-12 text-center text-white/50">
                    <i class="fa-solid fa-inbox fa-3x mb-4 text-[#FFD700]/40"></i>
                    <p class="text-lg">Aucune inscription enregistrée pour le moment.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-white border-collapse">
                        <thead class="bg-black/60 text-white/60 uppercase text-xs tracking-wide">
                            <tr>
                                <th class="p-4 font-semibold border-b border-[#FFD700]/15">Danseur</th>
                                <th class="p-4 font-semibold border-b border-[#FFD700]/15">Cours</th>
                                <th class="p-4 font-semibold border-b border-[#FFD700]/15">Saison</th>
                                <th class="p-4 font-semibold border-b border-[#FFD700]/15">Statut Dossier</th>
                                <th class="p-4 font-semibold border-b border-[#FFD700]/15 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for inscription in dernieres_inscriptions %}
                                <tr class="hover:bg-[#FFD700]/5 transition-colors group">
                                    <td class="p-4 border-b border-white/5 align-middle font-semibold group-last:border-0">
                                        {% if inscription.danseur %}
                                            {{ inscription.danseur.prenom }} {{ inscription.danseur.nom }}
                                        {% else %}
                                            <span class="text-rose-400 italic">Danseur introuvable</span>
                                        {% endif %}
                                    </td>
                                    <td class="p-4 border-b border-white/5 align-middle group-last:border-0">
                                        {{ inscription.cours ? inscription.cours.nom : 'Cours introuvable' }}
                                    </td>
                                    <td class="p-4 border-b border-white/5 align-middle text-white/60 group-last:border-0">
                                        {{ inscription.saison }}
                                    </td>
                                    <td class="p-4 border-b border-white/5 align-middle group-last:border-0">
                                        {% set s = inscription.statutDossier.value %}
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase 
                                            {% if s == 'En attente' %}
                                                bg-amber-500/15 text-amber-300 border border-amber-500/30
                                            {% elseif s == 'Incomplet' %}
                                                bg-rose-500/15 text-rose-300 border border-rose-500/30
                                            {% else %}
                                                bg-emerald-500/15 text-emerald-300 border border-emerald-500/30
                                            {% endif %}">
                                            {{ s }}
                                        </span>
                                    </td>
                                    <td class="p-4 border-b border-white/5 align-middle text-right group-last:border-0">
                                        {% set edit_url = ea_url()
                                            .setController('App\\Controller\\Admin\\InscriptionCrudController')
                                            .setAction('edit')
                                            .setEntityId(inscription.id)
                                        %}
                                        <a href="{{ edit_url }}" class="inline-flex items-center gap-2 bg-transparent text-[#FFD700] border border-[#FFD700] px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wide hover:bg-[#FFD700] hover:text-black transition-colors">
                                            <i class="fa-solid fa-pen-to-square"></i> Consulter
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}