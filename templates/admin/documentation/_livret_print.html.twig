<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ livret.title }} — Studio Danse 430</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 10.5pt;
            line-height: 1.45;
            color: #1a1a1a;
            margin: 0;
            padding: 0;
        }
        .livret-doc-header {
            border-bottom: 2.5px solid #1a1a1a;
            padding-bottom: 10px;
            margin-bottom: 18px;
        }
        .livret-doc-brand {
            color: #8b6914;
            font-weight: bold;
            font-size: 8.5pt;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        .livret-doc-header h1 {
            font-size: 16pt;
            margin: 4px 0 0;
            font-weight: bold;
        }
        .livret-doc-subtitle {
            color: #555;
            font-size: 10pt;
            margin: 4px 0 0;
        }
        h2 {
            font-size: 11pt;
            margin: 16px 0 8px;
            border-left: 3px solid #d4af37;
            padding-left: 8px;
            page-break-after: avoid;
        }
        h3 {
            font-size: 10pt;
            margin: 12px 0 6px;
            page-break-after: avoid;
        }
        p, ul, ol { margin: 0 0 8px; }
        ul, ol { padding-left: 18px; }
        li { margin-bottom: 3px; }
        .livret-toc {
            background: #f5f5f5;
            border: 1px solid #ccc;
            padding: 10px 14px;
            margin-bottom: 16px;
        }
        .livret-toc ol { margin: 0; }
        .livret-warning {
            background: #fff8e1;
            border: 1px solid #e6a800;
            border-left: 4px solid #e6a800;
            padding: 8px 10px;
            margin: 10px 0;
        }
        .livret-info {
            background: #eef6ff;
            border: 1px solid #90b8e0;
            border-left: 4px solid #3b82f6;
            padding: 8px 10px;
            margin: 10px 0;
        }
        table.livret-table {
            width: 100%;
            border-collapse: collapse;
            margin: 8px 0 12px;
            font-size: 9pt;
        }
        table.livret-table th,
        table.livret-table td {
            border: 1px solid #999;
            padding: 5px 7px;
            text-align: left;
            vertical-align: top;
        }
        table.livret-table th {
            background: #ececec;
            font-weight: bold;
        }
        code {
            font-family: DejaVu Sans Mono, monospace;
            font-size: 9pt;
            background: #f0f0f0;
        }
        .livret-footer {
            margin-top: 24px;
            padding-top: 8px;
            border-top: 1px solid #ccc;
            font-size: 8pt;
            color: #666;
        }
        .livret-page-break { page-break-before: always; }
    </style>
</head>
<body>
    {% block livret_document %}{% endblock %}
</body>
</html>
