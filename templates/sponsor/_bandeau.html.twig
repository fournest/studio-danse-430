{# templates/sponsor/_bandeau.html.twig #}
<div class="bg-black py-4 overflow-hidden border-t border-or-500">
    <div class="flex animate-marquee">
        
        <!-- Premier bloc de logos -->
        <div class="flex space-x-8 shrink-0 pr-8">
            {% for sponsor in sponsors %}
                <a href="{{ sponsor.lien ?? '#' }}" target="_blank" rel="noopener noreferrer"
                   class="flex-shrink-0 flex items-center justify-center w-40 h-16">
                    <img src="{{ asset('/uploads/logos/sponsors/' ~ sponsor.logo) }}" alt="{{ sponsor.nom }}"
                         class="max-h-full max-w-full object-contain"
                         onerror="this.style.display='none'">
                </a>
            {% endfor %}
        </div>

        <!-- Deuxième bloc identique (miroir) pour l'effet infini transparent -->
        <div class="flex space-x-8 shrink-0 pr-8" aria-hidden="true">
            {% for sponsor in sponsors %}
                <a href="{{ sponsor.lien ?? '#' }}" target="_blank" rel="noopener noreferrer"
                   class="flex-shrink-0 flex items-center justify-center w-40 h-16">
                    <img src="{{ asset('/uploads/logos/sponsors/' ~ sponsor.logo) }}" alt="{{ sponsor.nom }}"
                         class="max-h-full max-w-full object-contain"
                         onerror="this.style.display='none'">
                </a>
            {% endfor %}
        </div>

    </div>
</div>

<style>
    /* Définition du mouvement de translation */
    @keyframes marquee {
        from {
            transform: translateX(0%);
        }
        to {
            transform: translateX(-50%);
        }
    }

    /* Animation CSS pour le défilement */
    .animate-marquee {
        animation: marquee 25s linear infinite;
        display: flex;
        width: max-content;
    }
    
    /* Pause au survol */
    .animate-marquee:hover {
        animation-play-state: paused;
    }
</style>