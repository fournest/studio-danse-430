{% extends 'base.html.twig' %}

{% block title %}{{ page.titre }} — Studio Danse 430{% endblock %}

{% block body %}
<article class="bg-black min-h-[calc(100vh-4rem)] py-10 sm:py-14 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">
        <p class="mb-6">
            <a href="{{ path('app_home') }}" class="text-sm text-neutral-400 hover:text-[#FFD700] transition-colors">
                ← Retour à l'accueil
            </a>
        </p>

        <div class="rounded-2xl border border-[#FFD700]/25 bg-[#111111] shadow-xl overflow-hidden">
            <header class="px-6 sm:px-8 py-6 sm:py-8 border-b border-[#FFD700]/20 bg-linear-to-r from-[#1a1a1a] to-[#111111]">
                <p class="text-xs uppercase tracking-wider text-[#FFD700]/80 font-semibold mb-2">
                    Mis à jour le : {{ page.updatedAt|date('d/m/Y') }}
                </p>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-[#FFD700] tracking-tight leading-tight">
                    {{ page.titre }}
                </h1>
            </header>

            <div class="px-6 sm:px-8 py-8 sm:py-10 prose prose-invert prose-headings:text-[#FFD700] prose-a:text-[#FFD700] prose-strong:text-white max-w-none text-neutral-200 leading-relaxed">
                {{ page.contenu|raw }}
            </div>

            <footer class="px-6 sm:px-8 py-4 border-t border-white/10 text-xs text-neutral-500 text-center sm:text-end">
                Mis à jour le : {{ page.updatedAt|date('d/m/Y') }}
            </footer>
        </div>
    </div>
</article>
{% endblock %}
