{% extends 'base.html.twig' %}

{% block title %}Créer un compte - Studio Danse 430
{% endblock %}

{% block body %}
	<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] flex justify-center items-center">
		<div
			class="max-w-md w-full space-y-8 bg-neutral-900/60 p-8 rounded-xl border border-neutral-800 backdrop-blur-sm shadow-xl">

			{# En-tête de la carte #}
			<div class="text-center">
				<h2 class="text-3xl font-extrabold text-[#FFD700] tracking-tight">
					{% if is_coparent_invite|default(false) %}
						Créer mon compte co-parent
					{% else %}
						Créez votre compte
					{% endif %}
				</h2>
				<p class="mt-2 text-sm text-neutral-400">
					{% if is_coparent_invite|default(false) %}
						Accès en lecture seule pour suivre les cours de votre enfant
					{% else %}
						Étape 1 : Vos identifiants de connexion technique
					{% endif %}
				</p>
			</div>

			{# Début du formulaire #}
			{{ form_start(registrationForm, {'attr': {'class': 'mt-8 space-y-6'}}) }}

			{# Affichage des erreurs globales #}
			{% if form_errors(registrationForm) %}
				<div class="p-4 rounded-md bg-red-950/50 border border-red-800 text-red-400 text-sm">
					{{ form_errors(registrationForm) }}
				</div>
			{% endif %}

			{# Prénom & Nom #}
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<div>
					<label for="{{ registrationForm.prenom.vars.id }}" class="block text-sm font-medium text-neutral-300">Prénom</label>
					{{ form_widget(registrationForm.prenom, { attr: { class: 'mt-1 block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5' } }) }}
					<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.prenom) }}</div>
				</div>
				<div>
					<label for="{{ registrationForm.nom.vars.id }}" class="block text-sm font-medium text-neutral-300">Nom</label>
					{{ form_widget(registrationForm.nom, { attr: { class: 'mt-1 block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5' } }) }}
					<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.nom) }}</div>
				</div>
			</div>

			{# Champ Email #}
			<div>
				<label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium text-neutral-300">Adresse Email</label>
				{{ form_widget(registrationForm.email, {
                    'attr': {'class': 'mt-1 block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5 transition-colors'}
                }) }}
				<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.email) }}</div>
			</div>

			{# Champ Téléphone #}
			<div>
				<label for="{{ registrationForm.telephone.vars.id }}" class="block text-sm font-medium text-neutral-300">Numéro de téléphone</label>
				{{ form_widget(registrationForm.telephone, {
                    'attr': {'class': 'mt-1 block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5 transition-colors', 'placeholder': '06 12 34 56 78'}
                }) }}
				<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.telephone) }}</div>
			</div>

			{# Mot de passe #}
			<div>
				<label for="{{ registrationForm.plainPassword.first.vars.id }}" class="block text-sm font-medium text-neutral-300">Mot de passe</label>
				<div class="relative mt-1">
					{{ form_widget(registrationForm.plainPassword.first, {
						attr: { class: 'block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5 pr-10', placeholder: '••••••••', id: 'register-password' }
					}) }}
				</div>
				{% include 'security/_password_requirements.html.twig' with { input_id: 'register-password' } %}
				<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.plainPassword.first) }}</div>
			</div>
			<div>
				<label for="{{ registrationForm.plainPassword.second.vars.id }}" class="block text-sm font-medium text-neutral-300">Confirmation du mot de passe</label>
				{{ form_widget(registrationForm.plainPassword.second, {
					attr: { class: 'mt-1 block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5', placeholder: '••••••••' }
				}) }}
				<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.plainPassword.second) }}</div>
			</div>
			{{ form_errors(registrationForm.plainPassword) }}

			{# Case à cocher CGU #}
			<div class="flex items-start">
				<div class="flex items-center h-5">
					{{ form_widget(registrationForm.agreeTerms, {
                        'attr': {'class': 'h-4 w-4 rounded bg-black border-neutral-800 text-[#FFD700] focus:ring-[#FFD700]'}
                    }) }}
				</div>
				<div class="ml-3 text-sm">
					<label for="{{ registrationForm.agreeTerms.vars.id }}" class="font-medium text-neutral-300">
						J'accepte les conditions d'utilisation
					</label>
					<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.agreeTerms) }}</div>
				</div>
			</div>

			{# Bouton de soumission #}
			<div>
				<button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#FFD700] transition-colors duration-200 uppercase tracking-wider">
					Créer mon compte
				</button>
			</div>
			{{ form_end(registrationForm) }}

		</div>
	</div>
{% endblock %}
