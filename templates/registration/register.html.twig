{% extends 'base.html.twig' %}

{% block title %}Créer un compte - Studio Danse 430
{% endblock %}

{% block body %}
	<div class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-950 min-h-[calc(100vh-4rem)] flex justify-center items-center">
		<div
			class="max-w-md w-full space-y-8 bg-neutral-900/60 p-8 rounded-xl border border-neutral-800 backdrop-blur-sm shadow-xl">

			{# En-tête de la carte #}
			<div class="text-center">
				<h2 class="text-3xl font-extrabold text-[#FFD700] tracking-tight">
					Créez votre compte
				</h2>
				<p class="mt-2 text-sm text-neutral-400">
					Étape 1 : Vos identifiants de connexion technique
				</p>
			</div>

			{# Début du formulaire #}
			{{ form_start(registrationForm, {'attr': {'class': 'mt-8 space-y-6'}}) }}

			{# Affichage des erreurs globales #}
			{% if form_errors(registrationForm) %}
				<div class="p-4 rounded-md bg-red-950/50 border border-red-800 text-red-400 text-sm">
					{{ form_errors(registrationForm) }}
				</div>
			{% endif %}

			{# Champ Email #}
			<div>
				<label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium text-neutral-300">Adresse Email</label>
				{{ form_widget(registrationForm.email, {
                    'attr': {'class': 'mt-1 block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5 transition-colors'}
                }) }}
				<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.email) }}</div>
			</div>

			{# Champ Téléphone #}
			<div>
				<label for="{{ registrationForm.telephone.vars.id }}" class="block text-sm font-medium text-neutral-300">Numéro de téléphone</label>
				{{ form_widget(registrationForm.telephone, {
                    'attr': {'class': 'mt-1 block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5 transition-colors', 'placeholder': '06 12 34 56 78'}
                }) }}
				<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.telephone) }}</div>
			</div>

			{# Champ Mot de passe avec bouton oeil intégré #}
			<div>
				<label for="{{ registrationForm.plainPassword.vars.id }}" class="block text-sm font-medium text-neutral-300">Mot de passe</label>
				<div class="relative mt-1">
					{{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'class': 'block w-full rounded-md bg-black border border-neutral-800 text-white focus:border-[#FFD700] focus:ring-[#FFD700] sm:text-sm px-4 py-2.5 pr-10 transition-colors', 
                            'placeholder': '••••••••'
                        }
                    }) }}

					{# Bouton oeil centré dans l'input #}
					<button type="button" id="togglePassword" class="absolute right-3 top-1/2 -translate-y-1/2 text-[#FFD700] hover:text-[#FFD700]/80 transition-colors focus:outline-none p-1">
						<svg id="eye-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 20 20" fill="currentColor">
							<path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
							<path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM10 15a5 5 0 100-10 5 5 0 000 10z" clip-rule="evenodd"/>
						</svg>
						<svg id="eye-closed" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" viewbox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"/>
							<path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 1.037 0 2.043-.157 2.986-.447z"/>
						</svg>
					</button>
				</div>
				<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.plainPassword) }}</div>
			</div>

			{# Case à cocher CGU #}
			<div class="flex items-start">
				<div class="flex items-center h-5">
					{{ form_widget(registrationForm.agreeTerms, {
                        'attr': {'class': 'h-4 w-4 rounded bg-black border-neutral-800 text-[#FFD700] focus:ring-[#FFD700]'}
                    }) }}
				</div>
				<div class="ml-3 text-sm">
					<label for="{{ registrationForm.agreeTerms.vars.id }}" class="font-medium text-neutral-300">
						J'accepte les conditions d'utilisation
					</label>
					<div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.agreeTerms) }}</div>
				</div>
			</div>

			{# Bouton de soumission #}
			<div>
				<button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-md text-black bg-[#FFD700] hover:bg-[#FFD700]/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#FFD700] transition-colors duration-200 uppercase tracking-wider">
					Créer mon compte
				</button>
			</div>
			{{ form_end(registrationForm) }}

		</div>
	</div>

	{% block javascripts %}
		{{ parent() }}
		<script>
			document.addEventListener('DOMContentLoaded', function () {
const passwordInput = document.getElementById('{{ registrationForm.plainPassword.vars.id }}');
const toggleButton = document.getElementById('togglePassword');
const eyeOpen = document.getElementById('eye-open');
const eyeClosed = document.getElementById('eye-closed');

if (toggleButton && passwordInput) {
toggleButton.addEventListener('click', function () {
const isPassword = passwordInput.getAttribute('type') === 'password';
passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

// Bascule de l'icône SVG (ouvert / fermé)
if (isPassword) {
eyeOpen.classList.add('hidden');
eyeClosed.classList.remove('hidden');
} else {
eyeOpen.classList.remove('hidden');
eyeClosed.classList.add('hidden');
}
});
}
});
		</script>
	{% endblock %}
{% endblock %}
