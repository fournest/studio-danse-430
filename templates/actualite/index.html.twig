{% extends 'base.html.twig' %}

{% block title %}Actualités — Studio Danse 430{% endblock %}

{% block body %}
<div class="bg-black min-h-[calc(100vh-4rem)] py-14 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
            <h1 class="text-4xl sm:text-5xl font-extrabold text-[#FFD700] tracking-tight">Actualités</h1>
            <p class="mt-3 text-neutral-400 max-w-2xl mx-auto">
                Retrouvez les dernières nouvelles du Studio Danse 430.
            </p>
        </div>

        {% if actualites is empty %}
            <div class="text-center py-20 border border-dashed border-neutral-800 rounded-2xl">
                <p class="text-neutral-500">Aucune actualité publiée pour le moment.</p>
            </div>
        {% else %}
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for actu in actualites %}
                    {% include 'actualite/_card.html.twig' with { actu: actu } only %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
