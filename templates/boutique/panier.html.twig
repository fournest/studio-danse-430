{% extends 'base.html.twig' %}

{% block title %}Panier boutique — Studio Danse 430{% endblock %}

{% block body %}
<section class="bg-black py-12 border-b border-[#FFD700]/20">
	<div class="max-w-4xl mx-auto px-4 sm:px-6">
		<p class="text-xs font-bold uppercase tracking-wider text-[#FFD700]/80 mb-2">Étape 1 / 3</p>
		<h1 class="text-3xl sm:text-4xl font-extrabold text-[#FFD700]">Votre panier</h1>
		<p class="text-white/70 mt-2">Vérifiez les articles, tailles et quantités avant de commander.</p>
	</div>
</section>

<section class="bg-black py-10 min-h-[50vh]">
	<div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="p-4 rounded-md text-sm {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : (label == 'warning' ? 'bg-amber-950/50 border border-amber-800 text-amber-300' : 'bg-red-950/50 border border-red-800 text-red-400') }}">
					{{ message }}
				</div>
			{% endfor %}
		{% endfor %}

		{% if items is empty %}
			<div class="text-center py-16 border border-[#FFD700]/25 rounded-2xl">
				<p class="text-xl text-white/70">Votre panier est vide.</p>
				<a href="{{ path('app_boutique_index') }}" class="inline-block mt-6 px-6 py-3 rounded-full bg-[#FFD700] text-black font-bold hover:bg-yellow-400 transition-colors">
					Voir la boutique
				</a>
			</div>
		{% else %}
			<ul class="space-y-3">
				{% for item in items %}
					<li class="flex flex-col sm:flex-row sm:items-center gap-4 p-4 rounded-xl border border-neutral-800 bg-neutral-950/60">
						<div class="flex-1 min-w-0">
							<p class="font-bold text-white">{{ item.goodie.nom }}</p>
							<p class="text-xs text-neutral-500 mt-0.5">
								{% if item.taille %}Taille {{ item.taille }} · {% endif %}
								{{ item.prixUnitaire|number_format(2, ',', ' ') }} € / unité
							</p>
						</div>
						<form method="post" class="flex items-center gap-2" data-turbo="false">
							<input type="hidden" name="_token" value="{{ csrf_token('boutique_panier') }}">
							<input type="hidden" name="goodie_id" value="{{ item.goodie.id }}">
							<input type="hidden" name="taille" value="{{ item.taille|default('') }}">
							<input type="hidden" name="_action" value="update">
							<input type="number" name="quantite" value="{{ item.quantite }}" min="1" max="{{ item.goodie.stock + item.quantite }}"
								   class="w-16 rounded-lg bg-neutral-900 border border-neutral-700 text-white px-2 py-1.5 text-sm">
							<button type="submit" class="text-xs font-bold text-[#FFD700] hover:underline">OK</button>
						</form>
						<p class="font-bold text-[#FFD700] whitespace-nowrap">{{ item.prixTotal|number_format(2, ',', ' ') }} €</p>
						<form method="post" data-turbo="false">
							<input type="hidden" name="_token" value="{{ csrf_token('boutique_panier') }}">
							<input type="hidden" name="goodie_id" value="{{ item.goodie.id }}">
							<input type="hidden" name="taille" value="{{ item.taille|default('') }}">
							<input type="hidden" name="_action" value="remove">
							<button type="submit" class="text-xs text-red-400 hover:underline">Retirer</button>
						</form>
					</li>
				{% endfor %}
			</ul>

			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-4 border-t border-neutral-800">
				<a href="{{ path('app_boutique_index') }}" class="text-sm text-neutral-400 hover:text-[#FFD700] transition-colors">← Continuer mes achats</a>
				<div class="flex items-center gap-4">
					<p class="text-lg font-extrabold text-white">
						Total <span class="text-[#FFD700]">{{ total|number_format(2, ',', ' ') }} €</span>
					</p>
					<a href="{{ path('app_boutique_commande') }}"
					   class="px-6 py-3 rounded-full bg-[#FFD700] text-black font-bold hover:bg-yellow-400 transition-colors">
						Commander →
					</a>
				</div>
			</div>
		{% endif %}
	</div>
</section>
{% endblock %}
