{% extends 'base.html.twig' %}

{% block title %}Boutique — Goodies & Vêtements — Studio Danse 430{% endblock %}

{% block body %}
<section class="bg-black py-16 border-b border-[#FFD700]/20">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
		<span class="inline-block px-4 py-1 rounded-full text-xs font-bold bg-[#FFD700] text-black uppercase tracking-wider mb-3">
			Boutique officielle
		</span>
		<h1 class="text-4xl sm:text-5xl font-extrabold text-[#FFD700] mb-4">Boutique</h1>
		<p class="text-lg text-white/80 max-w-2xl mx-auto">
			Vêtements, accessoires et goodies du Studio Danse 430 — commande rapide, règlement séparé des inscriptions.
		</p>
		{% if panierCount is defined and panierCount > 0 %}
			<p class="mt-4">
				<a href="{{ path('app_boutique_panier') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#FFD700] text-[#FFD700] text-sm font-bold hover:bg-[#FFD700] hover:text-black transition-colors">
					Voir mon panier ({{ panierCount }})
				</a>
			</p>
		{% endif %}
	</div>
</section>

<section class="bg-black py-10 min-h-screen">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8">

		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="p-4 rounded-md text-sm {{ label == 'success' ? 'bg-green-950/50 border border-green-800 text-green-400' : (label == 'warning' ? 'bg-amber-950/50 border border-amber-800 text-amber-300' : 'bg-red-950/50 border border-red-800 text-red-400') }}">
					{{ message }}
				</div>
			{% endfor %}
		{% endfor %}

		<div class="flex flex-wrap gap-2 justify-center sm:justify-start">
			<a href="{{ path('app_boutique_index') }}"
			   class="px-4 py-2 rounded-full text-sm font-bold transition-colors {{ not categorieActive ? 'bg-[#FFD700] text-black' : 'border border-neutral-700 text-neutral-300 hover:border-[#FFD700] hover:text-[#FFD700]' }}">
				Tout
			</a>
			{% for cat in categories %}
				<a href="{{ path('app_boutique_index', {categorie: cat}) }}"
				   class="px-4 py-2 rounded-full text-sm font-bold transition-colors {{ categorieActive == cat ? 'bg-[#FFD700] text-black' : 'border border-neutral-700 text-neutral-300 hover:border-[#FFD700] hover:text-[#FFD700]' }}">
					{{ cat }}
				</a>
			{% endfor %}
		</div>

		{% if goodies is empty %}
			<div class="text-center py-20 border border-[#FFD700]/30 rounded-3xl bg-neutral-950">
				<p class="text-xl text-white/70">Aucun article disponible pour le moment.</p>
				<p class="text-white/50 mt-2">Le catalogue boutique sera bientôt enrichi.</p>
			</div>
		{% else %}
			<div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
				{% for goodie in goodies %}
					<article class="flex flex-col bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden hover:shadow-[0_0_30px_rgba(255,215,0,0.15)] hover:-translate-y-1 transition duration-300 group">
						<div class="relative aspect-4/3 overflow-hidden border-b border-neutral-800 bg-neutral-950">
							{% if goodie.imageFilename %}
								<img src="{{ asset('uploads/goodies/' ~ goodie.imageFilename) }}" alt="{{ goodie.nom }}"
									 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
							{% else %}
								<div class="w-full h-full flex flex-col items-center justify-center text-neutral-600 gap-2">
									<span class="text-3xl">👕</span>
									<span class="text-xs">Aucun visuel</span>
								</div>
							{% endif %}
							<span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wider bg-black/70 text-[#FFD700] border border-[#FFD700]/40">
								{{ goodie.categorie }}
							</span>
							<span class="absolute top-3 right-3 inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-black bg-[#FFD700] text-black shadow-lg">
								{{ goodie.prixUnitaire|number_format(2, ',', ' ') }} €
							</span>
						</div>

						<div class="p-5 flex-1 flex flex-col justify-between">
							<div>
								<h2 class="text-lg font-bold text-white line-clamp-1 group-hover:text-[#FFD700] transition-colors mb-1">
									{{ goodie.nom }}
								</h2>
								{% if goodie.description %}
									<p class="text-xs text-neutral-500 line-clamp-2 mb-3">{{ goodie.description }}</p>
								{% endif %}
								<p class="text-xs text-neutral-500">
									Stock :
									<span class="text-white font-medium">{{ goodie.stock }}</span>
								</p>
							</div>

							{% if not goodie.availableForSale %}
								<div class="mt-5 space-y-2">
									<button type="button" disabled
											class="w-full py-2.5 px-4 bg-neutral-800 text-neutral-500 font-bold text-center text-sm rounded-xl cursor-not-allowed opacity-60">
										Ajouter au panier
									</button>
									{% if goodie.saleStatus == 'À venir' and goodie.dateDebut %}
										<p class="text-center text-xs text-amber-300/90">
											Vente disponible le {{ goodie.dateDebut|date('d/m/Y à H\\hi') }}
										</p>
									{% else %}
										<p class="text-center text-xs text-neutral-500">Commandes fermées</p>
									{% endif %}
									{% if goodie.dateLivraisonPrevue %}
										<p class="text-center text-xs text-neutral-400">
											Livraison prévue : {{ goodie.dateLivraisonPrevue|date('d/m/Y') }}
										</p>
									{% endif %}
								</div>
							{% elseif goodie.stock < 1 %}
								<p class="mt-5 text-center text-sm text-neutral-500 font-semibold py-2.5">Rupture de stock</p>
							{% elseif is_granted('ROLE_USER') %}
								<form method="post" action="{{ path('app_boutique_ajouter', {id: goodie.id}) }}" class="mt-5 space-y-3" data-turbo="false">
									<input type="hidden" name="_token" value="{{ csrf_token('boutique_ajouter' ~ goodie.id) }}">
									{% if categorieActive %}
										<input type="hidden" name="categorie" value="{{ categorieActive }}">
									{% endif %}
									{% if goodie.taillesDisponibles is not empty %}
										<label class="block text-xs text-neutral-500">
											Taille
											<select name="taille" required
													class="mt-1 w-full rounded-lg bg-zinc-900 border border-zinc-700 text-white text-sm px-3 py-2">
												<option value="">Choisir…</option>
												{% for taille in goodie.taillesDisponibles %}
													<option value="{{ taille }}">{{ taille }}</option>
												{% endfor %}
											</select>
										</label>
									{% endif %}
									<button type="submit"
											class="w-full py-2.5 px-4 bg-amber-400 hover:bg-amber-300 text-black font-bold text-center text-sm rounded-xl transition-colors shadow-md shadow-amber-400/10">
										Ajouter au panier
									</button>
									{% if goodie.dateLivraisonPrevue %}
										<p class="text-center text-xs text-neutral-400">
											Livraison prévue : {{ goodie.dateLivraisonPrevue|date('d/m/Y') }}
										</p>
									{% endif %}
								</form>
							{% else %}
								<a href="{{ path('app_login') }}"
								   class="mt-5 block w-full py-2.5 px-4 bg-amber-400 hover:bg-amber-300 text-black font-bold text-center text-sm rounded-xl transition-colors shadow-md shadow-amber-400/10">
									Connectez-vous pour commander
								</a>
								{% if goodie.dateLivraisonPrevue %}
									<p class="mt-2 text-center text-xs text-neutral-400">
										Livraison prévue : {{ goodie.dateLivraisonPrevue|date('d/m/Y') }}
									</p>
								{% endif %}
							{% endif %}
						</div>
					</article>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
{% endblock %}
